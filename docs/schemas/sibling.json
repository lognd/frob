      "additionalProperties": false,
      "description": "The `packs` array and its digest; both or neither are emitted.",
      "properties": {
        "digest": {
          "description": "Pack digest of packs.md 2.5.",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "type": "string"
        },
        "name": {
          "description": "Pack id, `<namespace>/<name>`.",
          "type": "string"
        },
        "version": {
          "description": "Semantic version of the pack.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "description": "Half-open byte range inside the file named by the owning record.",
      "properties": {
        "end": {
          "description": "Byte offset one past the last byte.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "description": "Byte offset of the first byte.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "RequiredReason": {
      "description": "Why an Unresolved finding is required, so the gate fails on it (exit 1).",
      "oneOf": [
        {
          "description": "A configured sibling product is absent or incompatible.",
          "properties": {
            "kind": {
              "const": "sibling_missing",
              "type": "string"
            },
            "product": {
              "description": "The product or program that could not be used.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "product"
          ],
          "type": "object"
        },
        {
          "description": "An opaque needs an `annotation-required` declaration.",
          "properties": {
            "code": {
              "description": "The annotation code the declaration must carry.",
              "type": "string"
            },
            "kind": {
              "const": "annotation_required",
              "type": "string"
            },
            "public_surface": {
              "description": "True when the opaque sits on the public surface.",
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "code",
            "public_surface"
          ],
          "type": "object"
        },
        {
          "description": "A `must_measure` rule examined zero subjects.",
          "properties": {
            "kind": {
              "const": "zero_subjects",
              "type": "string"
            },
            "rule": {
              "description": "The rule id that measured nothing.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "rule"
          ],
          "type": "object"
        },
        {
          "description": "A rule could not be evaluated (unreadable ledger, config or milestones), so its silence is not a pass.",
          "properties": {
            "error": {
              "description": "The underlying error, as text.",
              "type": "string"
            },
            "kind": {
              "const": "evaluation_failed",
              "type": "string"
            },
            "rule": {
              "description": "The rule that was not evaluated.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "rule",
            "error"
          ],
          "type": "object"
        },
        {
          "description": "A configured tool stage could not run, exited abnormally or printed unreadable output.",
          "properties": {
            "kind": {
              "const": "tool_failed",
              "type": "string"
            },
            "stage": {
              "description": "The name of the tool stage that did not produce evidence.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "stage"
          ],
          "type": "object"
        }
      ]
    },
    "Role": {
      "description": "Role of a binding row (binding.md 1.2).",
      "oneOf": [
        {
          "const": "owns",
          "description": "Owns.",
          "type": "string"
        },
        {
          "const": "producer",
          "description": "Producer.",
          "type": "string"
        },
        {
          "const": "consumer",
          "description": "Consumer.",
          "type": "string"
        },
        {
          "const": "shape",
          "description": "Shape.",
          "type": "string"
        },
        {
          "const": "runnable",
          "description": "Runnable.",
          "type": "string"
        },
        {
          "const": "ref",
          "description": "Ref.",
          "type": "string"
        },
        {
          "const": "evidence",
          "description": "Evidence.",
          "type": "string"
        }
      ]
    },
    "RuleRecord": {
      "additionalProperties": false,
      "description": "Per-rule subject counts; a rule that ran with zero subjects appears with `subjects_examined` 0.",
      "properties": {
        "findings": {
          "description": "Live findings of this rule.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "polarity": {
          "$ref": "#/$defs/MarkOfPolarity",
          "description": "Declared polarity."
        },
        "rule": {
          "description": "Rule id.",
          "type": "string"
        },
        "subjects_examined": {
          "description": "Subjects examined across the whole run.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "suppressed": {
          "description": "Suppressed findings of this rule.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unresolved": {
          "description": "Unresolved sites of this rule.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rule",
        "polarity",
        "subjects_examined",
        "findings",
        "suppressed",
        "unresolved"
      ],
      "type": "object"
    },
    "SiblingDocument": {
      "additionalProperties": false,
      "dependentRequired": {
        "packs": [
          "packs_digest"
        ],
        "packs_digest": [
          "packs"
        ]
      },
      "description": "The data payload of `<product> check --json`.",
      "properties": {
        "bindings": {
          "description": "Rows of B; empty for a product with no model.",
          "items": {
            "$ref": "#/$defs/Binding"
          },
          "type": "array"
        },
        "compute": {
          "$ref": "#/$defs/ComputeKnobs",
          "description": "The `[compute]` knobs with defaults materialized; what the digest hashes."
        },
        "compute_digest": {
          "description": "blake3 of the canonical JSON of the `compute` object.",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "type": "string"
        },
        "entities": {
          "description": "Model entities; empty for a product with no model.",
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "type": "array"
        },
        "exceptions": {
          "description": "Every parsed exception, including those suppressing nothing.",
          "items": {
            "$ref": "#/$defs/ExceptionRecord"
          },
          "type": "array"
        },
        "fidelity": {
          "description": "One entry per language the run saw, sorted by language id.",
          "items": {
            "$ref": "#/$defs/Fidelity"
          },
          "type": "array"
        },
        "findings": {
          "description": "Live findings, sorted by file, line, rule.",
          "items": {
            "$ref": "#/$defs/FindingRow"
          },
          "type": "array"
        },
        "invocation": {
          "$ref": "#/$defs/Invocation",
          "description": "Echo of the arguments the product honoured."
        },
        "packs": {
          "description": "Enabled data packs used by the run, sorted by name; omitted by products without packs.",
          "items": {
            "$ref": "#/$defs/PackRef"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "packs_digest": {
          "description": "blake3 of the canonical JSON of the `packs` array; present exactly when `packs` is.",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "product": {
          "description": "Producing product.",
          "enum": [
            "grimble",
            "crunk"
          ],
          "type": "string"
        },
        "product_version": {
          "description": "Semantic version of the producing binary.",
          "type": "string"
        },
        "rules": {
          "description": "One entry per rule that ran, sorted by rule id.",
          "items": {
            "$ref": "#/$defs/RuleRecord"
          },
          "type": "array"
        },
        "schema_version": {
          "const": "gob.sibling/1",
          "description": "Contract name and major.",
          "type": "string"
        },
        "suppressed": {
          "description": "Findings parked by an exception.",
          "items": {
            "$ref": "#/$defs/SuppressedFinding"
          },
          "type": "array"
        },
        "timing": {
          "$ref": "#/$defs/Timing",
          "description": "Run timing."
        }
      },
      "required": [
        "schema_version",
        "product",
        "product_version",
        "compute_digest",
        "compute",
        "invocation",
        "fidelity",
        "rules",
        "findings",
        "suppressed",
        "exceptions",
        "entities",
        "bindings",
        "timing"
      ],
      "type": "object"
    },
    "SuppressedFinding": {
      "additionalProperties": false,
      "description": "A finding parked by an exception.",
      "properties": {
        "exception": {
          "description": "The `id` of the exception record that suppressed it.",
          "type": "string"
        },
        "finding": {
          "$ref": "#/$defs/FindingRow",
          "description": "The finding as it would have been reported."
        }
      },
      "required": [
        "finding",
        "exception"
      ],
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "description": "Run timing.",
      "properties": {
        "elapsed_ms": {
          "description": "Wall time of the run in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "elapsed_ms"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Stdout of a sibling product's `check --json` or `graph --json`: the envelope with the sibling document as `data`.",
  "else": {
    "properties": {
      "data": {
        "type": "null"
      },
      "error": {
        "type": "object"
      }
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    },
    "required": [
      "ok"
    ]
  },
  "properties": {
    "already": {
      "description": "Always false for a read-only verb.",
      "type": "boolean"
    },
    "data": {
      "description": "The verb payload; null only when ok is false.",
      "oneOf": [
        {
          "$ref": "#/$defs/SiblingDocument"
        },
        {
          "$ref": "#/$defs/GraphDocument"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "envelope.json#/$defs/EnvelopeError"
        },
        {
          "type": "null"
        }
      ],
      "description": "Error body when ok is false."
    },
    "findings": {
      "description": "Always empty: the document's own `findings` is authoritative.",
      "maxItems": 0,
      "type": "array"
    },
    "ok": {
      "description": "True when the product ran to completion; findings do not make it false.",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "description": "Envelope layout version."
    },
    "verb": {
      "description": "Dotted verb path, `check` or `graph`.",
      "type": "string"
    },
    "warnings": {
      "description": "Non-fatal notices.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "already",
    "data",
    "error",
    "findings",
    "ok",
    "schema_version",
    "verb",
    "warnings"
  ],
  "then": {
    "properties": {
      "data": {
        "type": "object"
      },
      "error": {
        "type": "null"
      }
    }
  },
  "title": "SiblingOutput",
  "type": "object"
}
