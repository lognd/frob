{
  "$comment": "hand-written until grimble's derive generates it (G03, 01M3Z712PSRGMHPGJ01CMBK6TR); references envelope.json by relative path",
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "description": "A row of the relation B, projected for display.",
      "properties": {
        "anchor": {
          "description": "Clause anchor or directive site that gave the row.",
          "type": [
            "string",
            "null"
          ]
        },
        "entity": {
          "description": "Anchor of the entity.",
          "pattern": "^[a-z]+/[A-Za-z0-9_.:/\\[\\]-]+$",
          "type": "string"
        },
        "identity": {
          "description": "Symref of the bound identity, or null for the hidden remainder of rank 4.",
          "type": [
            "string",
            "null"
          ]
        },
        "rank": {
          "description": "Source rank (binding.md section 2).",
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        "reason": {
          "description": "Residual reason code for rank 4 rows, null otherwise.",
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Role (binding.md 1.2).",
          "enum": [
            "owns",
            "producer",
            "consumer",
            "shape",
            "runnable",
            "ref",
            "evidence"
          ],
          "type": "string"
        },
        "status": {
          "description": "Status of the row.",
          "enum": [
            "must",
            "may",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "anchor",
        "entity",
        "identity",
        "rank",
        "reason",
        "role",
        "status"
      ],
      "type": "object"
    },
    "Capability": {
      "description": "Detector answer for one atom in one language: `typed` and `lexical` are precisions, `none` is no detector (unknown), `not_applicable` is declared impossible.",
      "enum": [
        "typed",
        "lexical",
        "none",
        "not_applicable"
      ],
      "type": "string"
    },
    "Directive": {
      "additionalProperties": false,
      "description": "A frob directive attached to an entity by the position rule of grmb-spec 8.1.",
      "properties": {
        "args": {
          "description": "Raw argument text after the verb, for frob's own directive parser.",
          "type": "string"
        },
        "line": {
          "description": "1-based line of the comment.",
          "minimum": 0,
          "type": "integer"
        },
        "namespace": {
          "description": "Only `frob:` directives are handed over; grimble consumes its own.",
          "enum": [
            "frob"
          ],
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/Range"
        },
        "verb": {
          "description": "Directive verb such as `ticket`, `doc`, `tests`.",
          "type": "string"
        }
      },
      "required": [
        "args",
        "line",
        "namespace",
        "range",
        "verb"
      ],
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "A model edge for the graph export.",
      "properties": {
        "anchor": {
          "description": "Clause anchor the edge was declared at.",
          "type": [
            "string",
            "null"
          ]
        },
        "contract": {
          "description": "Anchor of the flow's contract, for `flow` edges.",
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "description": "Anchor of the source entity or file.",
          "type": "string"
        },
        "kind": {
          "description": "Edge kind.",
          "enum": [
            "flow",
            "claim_operand",
            "vmodel_link",
            "include",
            "extend"
          ],
          "type": "string"
        },
        "to": {
          "description": "Anchor of the target entity or file.",
          "type": "string"
        }
      },
      "required": [
        "anchor",
        "contract",
        "from",
        "kind",
        "to"
      ],
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "description": "A model entity with its span, facet digests and attached frob directives.",
      "properties": {
        "anchor": {
          "description": "`kind/full-name`, the `design:` link target.",
          "pattern": "^[a-z]+/[A-Za-z0-9_.:/\\[\\]-]+$",
          "type": "string"
        },
        "body_digest": {
          "description": "Body facet digest, or null when unavailable.",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "digest_scheme": {
          "description": "Digest scheme version of the two digests.",
          "minimum": 0,
          "type": "integer"
        },
        "directives": {
          "description": "frob directives attached to this entity.",
          "items": {
            "$ref": "#/$defs/Directive"
          },
          "type": "array"
        },
        "doc_digest": {
          "description": "Doc facet digest, or null when unavailable.",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "description": "Repository-relative path of the declaring .grmb file.",
          "type": "string"
        },
        "kind": {
          "description": "Entity kind.",
          "enum": [
            "node",
            "flow",
            "contract",
            "claim",
            "vmodel",
            "boundary",
            "pack"
          ],
          "type": "string"
        },
        "line": {
          "description": "1-based line of the declaration.",
          "minimum": 0,
          "type": "integer"
        },
        "module": {
          "description": "The model module name.",
          "type": "string"
        },
        "name": {
          "description": "Full name including namespace prefixes.",
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/Range"
        },
        "renamed_from": {
          "description": "Transitional names (grmb-spec 4), so old `design:` links still resolve.",
          "items": {
            "description": "Former full name.",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "anchor",
        "body_digest",
        "digest_scheme",
        "directives",
        "doc_digest",
        "file",
        "kind",
        "line",
        "module",
        "name",
        "range",
        "renamed_from"
      ],
      "type": "object"
    },
    "ExceptionRecord": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "exit_state": {
                "const": "evaluated"
              }
            }
          },
          "if": {
            "properties": {
              "ticket": {
                "type": "string"
              }
            },
            "required": [
              "ticket"
            ]
          },
          "then": {
            "properties": {
              "exit_state": {
                "const": "unresolved_exit"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "accept"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ticket": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "One parsed exception, whether or not it currently suppresses a finding.",
      "properties": {
        "because": {
          "description": "The reason text, verbatim.",
          "type": "string"
        },
        "exit_state": {
          "description": "`unresolved_exit` whenever `ticket` is set (only frob evaluates ticket-bound exits); `evaluated` otherwise.",
          "enum": [
            "evaluated",
            "unresolved_exit"
          ],
          "type": "string"
        },
        "file": {
          "description": "Repository-relative file holding the exception, or null for a baseline pool key.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable id: lowercase hex of the hash of kind, rule and site.",
          "pattern": "^[0-9a-f]{16,64}$",
          "type": "string"
        },
        "kind": {
          "description": "Exception kind (exceptions.md section 1).",
          "enum": [
            "accept",
            "defer",
            "hotfix",
            "baseline"
          ],
          "type": "string"
        },
        "line": {
          "description": "1-based line of the exception, or null.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "on": {
          "description": "Anchor, symref or glob the exception applies to.",
          "type": "string"
        },
        "rule": {
          "description": "The excepted rule id.",
          "type": "string"
        },
        "status": {
          "description": "Outcome of the exits the product itself evaluated (date, digest, staleness), or null when none was evaluated.",
          "enum": [
            "active",
            "stale",
            "reattest",
            "expired",
            null
          ]
        },
        "suppresses": {
          "description": "Number of findings this exception suppressed in this run.",
          "minimum": 0,
          "type": "integer"
        },
        "ticket": {
          "description": "The `ticket=` value, verbatim and opaque: the sibling never resolves it.",
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "description": "ISO date `YYYY-MM-DD` of the optional date exit, or null.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "because",
        "exit_state",
        "file",
        "id",
        "kind",
        "line",
        "on",
        "rule",
        "status",
        "suppresses",
        "ticket",
        "until"
      ],
      "type": "object"
    },
    "Fidelity": {
      "additionalProperties": false,
      "description": "Fidelity of one language: level, capability precisions and the rules that do not apply.",
      "properties": {
        "adapter": {
          "description": "Adapter id.",
          "type": "string"
        },
        "adapter_version": {
          "description": "Adapter version.",
          "type": "string"
        },
        "capabilities": {
          "additionalProperties": {
            "$ref": "#/$defs/Capability"
          },
          "description": "Detector answer per capability atom, keyed by pack-qualified atom id.",
          "type": "object"
        },
        "language": {
          "description": "Language id as in the adapter registry.",
          "type": "string"
        },
        "level": {
          "description": "Fidelity level of universal-model.md 3.3.",
          "enum": [
            "F0",
            "F1",
            "F2",
            "F3",
            "F4"
          ],
          "type": "string"
        },
        "not_applicable_rules": {
          "description": "Rules whose whole scope is NotApplicable in this language (listed once, never findings).",
          "items": {
            "description": "Rule id.",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "adapter",
        "adapter_version",
        "capabilities",
        "language",
        "level",
        "not_applicable_rules"
      ],
      "type": "object"
    },
    "Finding": {
      "allOf": [
        {
          "$ref": "envelope.json#/$defs/FindingRecord"
        },
        {
          "else": {
            "properties": {
              "maybe": {
                "maxItems": 0
              },
              "reason": {
                "type": "null"
              },
              "required": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "severity": {
                "const": "unresolved"
              }
            },
            "required": [
              "severity"
            ]
          },
          "properties": {
            "anchor": {
              "description": "Logical location such as `node/cli/owns[0]`, or null for a code location.",
              "pattern": "^[a-z]+/[A-Za-z0-9_.:/\\[\\]-]+$",
              "type": [
                "string",
                "null"
              ]
            },
            "entity": {
              "description": "The `kind/name` of the entity the finding concerns, or null.",
              "pattern": "^[a-z]+/[A-Za-z0-9_.:/\\[\\]-]+$",
              "type": [
                "string",
                "null"
              ]
            },
            "fingerprint": {
              "description": "Stable fingerprint, 64 lowercase hex digits, not yet namespaced by product.",
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "maybe": {
              "description": "For Unresolved on P+ rules: the maybe-set `hi` minus `lo`; empty otherwise.",
              "items": {
                "description": "Anchor or symref.",
                "type": "string"
              },
              "type": "array"
            },
            "polarity": {
              "description": "Declared polarity of the rule (universal-model.md 4.2).",
              "enum": [
                "P+",
                "P-",
                "P0",
                "Pn",
                "Pc"
              ],
              "type": "string"
            },
            "range": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Range"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Byte range of the span in `file`, or null."
            },
            "reason": {
              "description": "Unresolved reason code (kebab-case such as `vacuous`, `fidelity`, `opaque-cone`); null unless severity is unresolved.",
              "pattern": "^[a-z][a-z0-9-]*$",
              "type": [
                "string",
                "null"
              ]
            },
            "remedy": {
              "description": "The exact corrected command or edit, when one exists.",
              "type": [
                "string",
                "null"
              ]
            },
            "severity": {
              "description": "Lowercase severity label as gob-diagnostics prints it (Warn is `warning`).",
              "enum": [
                "error",
                "warning",
                "advisory",
                "unresolved"
              ],
              "type": "string"
            },
            "subjects_examined": {
              "description": "Subjects the rule examined in the scope this finding rolls up; zero only with a vacuous Unresolved.",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "slug",
            "file",
            "line",
            "column",
            "fix",
            "required",
            "polarity",
            "subjects_examined",
            "reason",
            "maybe",
            "anchor",
            "entity",
            "range",
            "remedy"
          ],
          "then": {
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          },
          "type": "object"
        }
      ],
      "description": "A FindingRecord extended with polarity, subject accounting, reason and location anchors.",
      "unevaluatedProperties": false
    },
    "GraphDocument": {
      "additionalProperties": false,
      "description": "The data payload of `grimble graph --json`.",
      "properties": {
        "bindings": {
          "description": "Same records as SiblingDocument.bindings.",
          "items": {
            "$ref": "#/$defs/Binding"
          },
          "type": "array"
        },
        "compute_digest": {
          "description": "As in SiblingDocument.",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "type": "string"
        },
        "edges": {
          "description": "Model edges.",
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        },
        "entities": {
          "description": "Same records as SiblingDocument.entities.",
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "type": "array"
        },
        "module": {
          "description": "The model module name.",
          "type": "string"
        },
        "product": {
          "const": "grimble",
          "description": "Always grimble.",
          "type": "string"
        },
        "product_version": {
          "description": "Semantic version of the producing binary.",
          "type": "string"
        },
        "schema_version": {
          "const": "grimble.graph/1",
          "description": "Graph contract name and major.",
          "type": "string"
        }
      },
      "required": [
        "bindings",
        "compute_digest",
        "edges",
        "entities",
        "module",
        "product",
        "product_version",
        "schema_version"
      ],
      "type": "object"
    },
    "Invocation": {
      "additionalProperties": false,
      "description": "Echo of the arguments the product honoured, so frob can verify its request was applied.",
      "properties": {
        "base": {
          "description": "The `--base` ref the run diffed against, or null when no diff-scoped rule ran.",
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "const": ".",
          "description": "Repository root all paths are relative to; always `.`.",
          "type": "string"
        },
        "ticket_scope": {
          "description": "The `--ticket-scope` paths the run honoured, or null when the run was unscoped.",
          "items": {
            "description": "Repository-relative path.",
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "verb": {
          "description": "The verb that produced the document.",
          "enum": [
            "check"
          ],
          "type": "string"
        }
      },
      "required": [
        "base",
        "root",
        "ticket_scope",
        "verb"
      ],
      "type": "object"
    },
    "PackRef": {
      "additionalProperties": false,
      "description": "Identity of one enabled data pack: name, version and pack digest (packs.md section 7).",
      "properties": {
        "digest": {
          "description": "Pack digest of packs.md 2.5.",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "type": "string"
        },
        "name": {
          "description": "Pack id, `<namespace>/<name>`.",
          "type": "string"
        },
        "version": {
          "description": "Semantic version of the pack.",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "name",
        "version"
      ],
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "description": "Half-open byte range inside the file named by the owning record.",
      "properties": {
        "end": {
          "description": "Byte offset one past the last byte.",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "description": "Byte offset of the first byte.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    },
    "RuleRecord": {
      "additionalProperties": false,
      "description": "Per-rule subject counts; a rule that ran with zero subjects appears with `subjects_examined` 0.",
      "properties": {
        "findings": {
          "description": "Live findings of this rule.",
          "minimum": 0,
          "type": "integer"
        },
        "polarity": {
          "description": "Declared polarity.",
          "enum": [
            "P+",
            "P-",
            "P0",
            "Pn",
            "Pc"
          ],
          "type": "string"
        },
        "rule": {
          "description": "Rule id.",
          "type": "string"
        },
        "subjects_examined": {
          "description": "Subjects examined across the whole run.",
          "minimum": 0,
          "type": "integer"
        },
        "suppressed": {
          "description": "Suppressed findings of this rule.",
          "minimum": 0,
          "type": "integer"
        },
        "unresolved": {
          "description": "Unresolved sites of this rule.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "findings",
        "polarity",
        "rule",
        "subjects_examined",
        "suppressed",
        "unresolved"
      ],
      "type": "object"
    },
    "SiblingDocument": {
      "additionalProperties": false,
      "dependentRequired": {
        "packs": [
          "packs_digest"
        ],
        "packs_digest": [
          "packs"
        ]
      },
      "description": "The data payload of `<product> check --json`.",
      "properties": {
        "bindings": {
          "description": "Rows of B; empty for a product with no model.",
          "items": {
            "$ref": "#/$defs/Binding"
          },
          "type": "array"
        },
        "compute": {
          "additionalProperties": false,
          "description": "The [compute] knobs with defaults materialized; what the digest hashes.",
          "properties": {
            "dynamic_calls": {
              "description": "`[compute] dynamic_calls`.",
              "type": "string"
            },
            "effects": {
              "description": "`[compute] effects`.",
              "type": "string"
            },
            "expansion_steps": {
              "description": "`[compute] expansion_steps`.",
              "minimum": 0,
              "type": "integer"
            },
            "normalization": {
              "description": "`[compute] normalization`.",
              "type": "string"
            },
            "notebook_order": {
              "description": "`[compute] notebook_order`.",
              "type": "string"
            },
            "public_signatures": {
              "description": "`[compute] public_signatures`.",
              "type": "string"
            }
          },
          "required": [
            "dynamic_calls",
            "effects",
            "expansion_steps",
            "normalization",
            "notebook_order",
            "public_signatures"
          ],
          "type": "object"
        },
        "compute_digest": {
          "description": "blake3 of the canonical JSON of the `compute` object.",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "type": "string"
        },
        "entities": {
          "description": "Model entities; empty for a product with no model.",
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "type": "array"
        },
        "exceptions": {
          "description": "Every parsed exception, including those suppressing nothing.",
          "items": {
            "$ref": "#/$defs/ExceptionRecord"
          },
          "type": "array"
        },
        "fidelity": {
          "description": "One entry per language the run saw, sorted by language id.",
          "items": {
            "$ref": "#/$defs/Fidelity"
          },
          "type": "array"
        },
        "findings": {
          "description": "Live findings, sorted by file, line, rule.",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "invocation": {
          "$ref": "#/$defs/Invocation"
        },
        "packs": {
          "description": "Enabled data packs used by the run, sorted by name; omitted by products without packs (additive key).",
          "items": {
            "$ref": "#/$defs/PackRef"
          },
          "type": "array"
        },
        "packs_digest": {
          "description": "blake3 of the canonical JSON of the `packs` array; present exactly when `packs` is.",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "type": "string"
        },
        "product": {
          "description": "Producing product.",
          "enum": [
            "grimble",
            "crunk"
          ],
          "type": "string"
        },
        "product_version": {
          "description": "Semantic version of the producing binary.",
          "type": "string"
        },
        "rules": {
          "description": "One entry per rule that ran, sorted by rule id.",
          "items": {
            "$ref": "#/$defs/RuleRecord"
          },
          "type": "array"
        },
        "schema_version": {
          "const": "gob.sibling/1",
          "description": "Contract name and major.",
          "type": "string"
        },
        "suppressed": {
          "description": "Findings parked by an exception.",
          "items": {
            "$ref": "#/$defs/SuppressedFinding"
          },
          "type": "array"
        },
        "timing": {
          "additionalProperties": false,
          "description": "Run timing.",
          "properties": {
            "elapsed_ms": {
              "description": "Wall time of the run in milliseconds.",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "elapsed_ms"
          ],
          "type": "object"
        }
      },
      "required": [
        "bindings",
        "compute",
        "compute_digest",
        "entities",
        "exceptions",
        "fidelity",
        "findings",
        "invocation",
        "product",
        "product_version",
        "rules",
        "schema_version",
        "suppressed",
        "timing"
      ],
      "type": "object"
    },
    "SuppressedFinding": {
      "additionalProperties": false,
      "description": "A finding parked by an exception.",
      "properties": {
        "exception": {
          "description": "The `id` of the ExceptionRecord that suppressed it.",
          "type": "string"
        },
        "finding": {
          "$ref": "#/$defs/Finding",
          "description": "The finding as it would have been reported."
