        },
        "on": {
          "description": "Anchor, symref or glob the exception applies to.",
          "type": "string"
        },
        "rule": {
          "description": "The excepted rule id.",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExceptionStatus"
