            "type": "string"
          },
          "type": "array"
        },
        "message": {
          "description": "Human-readable message.",
          "type": "string"
        },
        "polarity": {
          "$ref": "#/$defs/MarkOfPolarity",
          "description": "Declared polarity of the rule (universal-model.md 4.2)."
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "description": "Byte range of the span in `file`, or null."
        },
        "reason": {
          "description": "Unresolved reason code (kebab-case such as `vacuous`, `fidelity`); null unless severity is unresolved.",
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": [
            "string",
            "null"
          ]
        },
        "remedy": {
          "description": "The exact corrected command or edit, when one exists.",
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequiredReason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why this Unresolved finding fails the gate under `required`, if it does."
        },
        "rule": {
          "description": "Rule id such as `COV006`.",
          "type": "string"
        },
        "severity": {
          "description": "Lowercase severity label.",
          "type": "string"
        },
        "slug": {
          "description": "Kebab-case slug when the registry knows the rule.",
          "type": [
            "string",
            "null"
          ]
        },
        "subjects_examined": {
          "description": "Subjects the rule examined in the scope this finding rolls up; zero only with a vacuous Unresolved.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rule",
        "slug",
        "severity",
        "file",
        "line",
        "column",
        "message",
        "fingerprint",
        "fix",
        "required",
        "polarity",
        "subjects_examined",
        "reason",
        "maybe",
        "anchor",
        "entity",
        "remedy",
        "range"
      ],
      "then": {
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "type": "object",
      "unevaluatedProperties": false
    },
