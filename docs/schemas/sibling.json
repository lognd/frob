      "required": [
        "verb",
        "root",
        "ticket_scope",
        "base"
      ],
      "type": "object"
    },
    "Level": {
      "description": "Fidelity level of universal-model.md 3.3.",
      "oneOf": [
        {
          "const": "F0",
          "description": "Opaque.",
          "type": "string"
        },
        {
          "const": "F1",
          "description": "Lexical.",
          "type": "string"
        },
        {
          "const": "F2",
          "description": "Structural.",
          "type": "string"
        },
        {
          "const": "F3",
          "description": "Typed.",
          "type": "string"
        },
        {
          "const": "F4",
          "description": "Full.",
          "type": "string"
        }
      ]
    },
    "MarkOfPolarity": {
      "description": "Declared polarity of a rule (universal-model.md 4.2); serialized as the symbol.",
      "oneOf": [
        {
          "const": "P+",
          "description": "Positive.",
          "type": "string"
        },
        {
          "const": "P-",
          "description": "Negative.",
          "type": "string"
        },
        {
          "const": "P0",
          "description": "Zero.",
          "type": "string"
        },
        {
          "const": "Pn",
          "description": "Neutral.",
          "type": "string"
        },
        {
          "const": "Pc",
          "description": "Conditional.",
          "type": "string"
        }
      ]
    },
