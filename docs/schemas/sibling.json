          "type": "string"
        },
        "ticket_scope": {
          "description": "The `--ticket-scope` paths the run honoured, or null when the run was unscoped.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "verb": {
          "description": "The verb that produced the document.",
          "enum": [
            "check"
