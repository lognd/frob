    "ExceptionRecord": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "exit_state": {
                "const": "evaluated"
              }
            }
          },
          "if": {
            "properties": {
              "ticket": {
                "type": "string"
              }
            },
            "required": [
              "ticket"
            ]
          },
          "then": {
            "properties": {
              "exit_state": {
                "const": "unresolved_exit"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "accept"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ticket": {
                "type": "null"
              }
            }
          }
        }
      ],
