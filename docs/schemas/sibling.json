    "FindingRow": {
      "description": "A finding as the landed record plus the sibling's extras.",
      "else": {
        "properties": {
          "maybe": {
            "maxItems": 0
          },
          "reason": {
            "type": "null"
          },
          "required": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "severity": {
            "const": "unresolved"
          }
        },
        "required": [
          "severity"
        ]
      },
      "properties": {
        "anchor": {
          "description": "Logical location such as `node/cli/owns[0]`, or null for a code location.",
          "pattern": "^[a-z]+/[A-Za-z0-9_.:/\\[\\]-]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "column": {
          "description": "1-based column of the span start.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "entity": {
          "description": "The `kind/name` of the entity the finding concerns, or null.",
          "pattern": "^[a-z]+/[A-Za-z0-9_.:/\\[\\]-]+$",
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "description": "File path when the finding has a resolvable location.",
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "description": "Stable fingerprint, lowercase hex.",
          "type": "string"
        },
        "fix": {
          "description": "Title of the attached fix, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "1-based line of the span start.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "maybe": {
          "description": "For Unresolved on P+ rules: the maybe-set `hi` minus `lo`; empty otherwise.",
