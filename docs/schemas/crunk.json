{
  "$comment": "generated by cargo dev gen schemas; do not edit",
  "$defs": {
    "Action": {
      "description": "A step of a state's interaction script, run after the entry loads and before capture.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Click `selector`.",
          "properties": {
            "kind": {
              "const": "click",
              "type": "string"
            },
            "selector": {
              "description": "CSS selector, non-empty.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "selector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Hover `selector`.",
          "properties": {
            "kind": {
              "const": "hover",
              "type": "string"
            },
            "selector": {
              "description": "CSS selector, non-empty.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "selector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Focus `selector`.",
          "properties": {
            "kind": {
              "const": "focus",
              "type": "string"
            },
            "selector": {
              "description": "CSS selector, non-empty.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "selector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Type `value` into `selector`.",
          "properties": {
            "kind": {
              "const": "fill",
              "type": "string"
            },
            "selector": {
              "description": "CSS selector, non-empty.",
              "type": "string"
            },
            "value": {
              "default": "",
              "description": "Text to type.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "selector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Press `key` while `selector` is focused.",
          "properties": {
            "key": {
              "description": "Key name, non-empty.",
              "type": "string"
            },
            "kind": {
              "const": "press",
              "type": "string"
            },
            "selector": {
              "description": "CSS selector, non-empty.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "selector",
            "key"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Wait for `selector` to appear.",
          "properties": {
            "kind": {
              "const": "wait_for",
              "type": "string"
            },
            "selector": {
              "description": "CSS selector, non-empty.",
              "type": "string"
            },
            "timeout_ms": {
              "default": null,
              "description": "Renderer-enforced timeout in ms, greater than zero.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "selector"
          ],
          "type": "object"
        }
      ]
    },
    "ClassCase": {
      "description": "Class-name casing enforced by ORG rules.",
      "oneOf": [
        {
          "const": "kebab",
          "description": "`my-class`.",
          "type": "string"
        },
        {
          "const": "snake",
          "description": "`my_class`.",
          "type": "string"
        },
        {
          "const": "camel",
          "description": "`myClass`.",
          "type": "string"
        }
      ]
    },
    "ColorScheme": {
      "description": "The `prefers-color-scheme` a platform or state emulates.",
      "oneOf": [
        {
          "const": "light",
          "description": "Light mode.",
          "type": "string"
        },
        {
          "const": "dark",
          "description": "Dark mode.",
          "type": "string"
        },
        {
          "const": "no-preference",
          "description": "No preference.",
          "type": "string"
        }
      ]
    },
    "Engine": {
      "description": "Browser engines the built-in `web` renderer drives.",
      "oneOf": [
        {
          "const": "chromium",
          "description": "Chromium.",
          "type": "string"
        },
        {
          "const": "firefox",
          "description": "Firefox.",
          "type": "string"
        },
        {
          "const": "webkit",
          "description": "`WebKit`.",
          "type": "string"
        }
      ]
    },
    "JsxConfig": {
      "additionalProperties": false,
      "description": "The `[jsx]` table: sources to ingest for style props and `className` strings.",
      "properties": {
        "globs": {
          "default": [],
          "description": "Root-relative globs of `.tsx` and `.jsx` sources; empty means JSX ingest is off.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "MediaFeatures": {
      "additionalProperties": false,
      "description": "Emulated media features (`prefers-reduced-motion`, `prefers-color-scheme`).",
      "properties": {
        "color_scheme": {
          "$ref": "#/$defs/ColorScheme",
          "default": "no-preference",
          "description": "Emulated `prefers-color-scheme`."
        },
        "reduced_motion": {
          "default": false,
          "description": "Emulate `prefers-reduced-motion: reduce`.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "NetworkAction": {
      "description": "What a network override does to the requests it matches.",
      "oneOf": [
        {
          "const": "abort",
          "description": "Abort the request.",
          "type": "string"
        },
        {
          "const": "status",
          "description": "Answer with `status`.",
          "type": "string"
        },
        {
          "const": "delay",
          "description": "Delay by `delay_ms`.",
          "type": "string"
        },
        {
          "const": "hold",
          "description": "Never resolve (the loading-state primitive).",
          "type": "string"
        }
      ]
    },
    "NetworkOverride": {
      "additionalProperties": false,
      "description": "A state's network override for requests matching `url_pattern`.",
      "properties": {
        "action": {
          "$ref": "#/$defs/NetworkAction",
          "description": "What to do to matching requests."
        },
        "delay_ms": {
          "description": "Delay in ms, greater than zero, for `action = \"delay\"`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "description": "HTTP status 100 to 599, for `action = \"status\"`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "url_pattern": {
          "description": "URL pattern of the requests to override, non-empty.",
          "type": "string"
        }
      },
      "required": [
        "url_pattern",
        "action"
      ],
      "type": "object"
    },
    "NetworkThrottle": {
      "additionalProperties": false,
      "description": "A web renderer's CDP network-throttling profile (chromium only).",
      "properties": {
        "download": {
          "description": "Download throughput in bytes per second, greater than zero.",
          "format": "double",
          "type": "number"
        },
        "latency": {
          "default": 0.0,
          "description": "Added latency in milliseconds, at least zero.",
          "format": "double",
          "type": "number"
        },
        "upload": {
          "description": "Upload throughput in bytes per second, greater than zero.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "download",
        "upload"
      ],
      "type": "object"
    },
    "OrgModel": {
      "description": "How style files are organized.",
      "oneOf": [
        {
          "const": "buckets",
          "description": "Files live in the declared buckets.",
          "type": "string"
        },
        {
          "const": "utility-first",
          "description": "Utility-first (Tailwind style) organization.",
          "type": "string"
        }
      ]
    },
    "RawPlatform": {
      "additionalProperties": false,
      "description": "One `[[platform]]` entry: an id, a renderer and that renderer's parameters.\n\nThe `web` renderer takes `engine` and `viewport` (required) plus the other web keys; the\n`command` renderer takes `command` (required), `cwd` and `env`. A key of the other renderer\nis rejected at load. Parameters are flat in the entry, not nested.",
      "properties": {
        "base_url": {
          "description": "web: base URL renders hit for approval; use the real production edge, never a dev\nserver whose SPA fallback masks 404s.",
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "description": "command: the command line, non-empty.",
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_throttle": {
          "description": "web, chromium only: CPU throttling multiplier, at least 1.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "cwd": {
          "description": "command: working directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "device_scale": {
          "description": "web: device scale factor, greater than zero (default 1).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "engine": {
          "anyOf": [
            {
              "$ref": "#/$defs/Engine"
            },
            {
              "type": "null"
            }
          ],
          "description": "web: browser engine."
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "command: extra environment variables.",
          "type": [
            "object",
            "null"
          ]
        },
        "id": {
          "description": "Platform id, unique across `[[platform]]`.",
          "type": "string"
        },
        "init_scripts": {
          "description": "web: scripts added with `add_init_script` before navigation.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "java_script_enabled": {
          "description": "web: whether JavaScript is enabled (default true).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "locale": {
          "description": "web: browser locale.",
          "type": [
            "string",
            "null"
          ]
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaFeatures"
            },
            {
              "type": "null"
            }
          ],
          "description": "web: emulated media features."
        },
        "network_throttle": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkThrottle"
            },
            {
              "type": "null"
            }
          ],
          "description": "web, chromium only: network throttling profile."
        },
        "renderer": {
          "description": "Renderer id: `web` or `command`.",
          "type": "string"
        },
        "settle_ms": {
          "description": "web: platform-level settle delay in ms added to the readiness wait (default 500).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "tags": {
          "default": [],
          "description": "Tags a screen's `applies_to` may reference as `tag:<name>`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "viewport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Viewport"
            },
            {
              "type": "null"
            }
          ],
          "description": "web: viewport size."
        }
      },
      "required": [
        "id",
        "renderer"
      ],
      "type": "object"
    },
    "RawTokens": {
      "additionalProperties": false,
      "description": "The `[tokens]` table: prefixes, an optional verbatim CSS header and a JSON export path.",
      "properties": {
        "header": {
          "default": "",
          "description": "A complete CSS comment block emitted verbatim above the generated marker; empty means\nno header. Must start with `/*`, end with `*/` and hold no interior `*/`.",
          "type": "string"
        },
        "json_file": {
          "default": "",
          "description": "Path of a committed flat JSON export of the tokens, relative to the project root; empty\nmeans none.",
          "type": "string"
        },
        "prefixes": {
          "$ref": "#/$defs/TokenPrefixes",
          "default": {
            "color": "color",
            "font_family": "font-family",
            "font_size": "font-size",
            "layer": "layer",
            "radius": "radius",
            "size": "size",
            "space": "space"
          },
          "description": "Custom-property prefixes, see `[tokens.prefixes]`."
        }
      },
      "type": "object"
    },
    "RosterEntry": {
      "additionalProperties": false,
      "description": "One `[[session]]` or `[[mock_set]]` roster entry: an id plus opaque renderer-consumed data.",
      "properties": {
        "data": {
          "additionalProperties": true,
          "default": {},
          "description": "Opaque data the renderer reads.",
          "type": "object"
        },
        "id": {
          "description": "Entry id, unique within its roster.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "ScreenConfig": {
      "additionalProperties": false,
      "description": "One `[[screen]]` entry: a route, page or activity with named states.",
      "properties": {
        "applies_to": {
          "description": "Platform ids and `tag:<name>` entries the screen applies to; absent means every platform.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "entry": {
          "description": "Entry route, page or activity.",
          "type": "string"
        },
        "id": {
          "description": "Screen id, unique across `[[screen]]`.",
          "type": "string"
        },
        "states": {
          "description": "Named states, at least one.",
          "items": {
            "$ref": "#/$defs/ScreenState"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "entry",
        "states"
      ],
      "type": "object"
    },
    "ScreenState": {
      "additionalProperties": false,
      "description": "One named state of a `[[screen]]`.",
      "properties": {
        "actions": {
          "default": [],
          "description": "Ordered interaction script.",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "type": "array"
        },
        "applies_to": {
          "description": "Narrower platform set than the screen's: platform ids and `tag:<name>` entries.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "diff_against": {
          "description": "Id of a sibling state this one is diffed against.",
          "type": [
            "string",
            "null"
          ]
        },
        "expect_url": {
          "description": "URL the page must end on.",
          "type": [
            "string",
            "null"
          ]
        },
        "fixture": {
          "description": "Fixture path used to reach the state.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "State id, unique within its screen.",
          "type": "string"
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaFeatures"
            },
            {
              "type": "null"
            }
          ],
          "description": "Media features overlaid on the platform's."
        },
        "mock": {
          "description": "Id of a declared `[[mock_set]]`.",
          "type": [
            "string",
            "null"
          ]
        },
        "network": {
          "default": [],
          "description": "Network overrides.",
          "items": {
            "$ref": "#/$defs/NetworkOverride"
          },
          "type": "array"
        },
        "session": {
          "description": "Id of a declared `[[session]]`.",
          "type": [
            "string",
            "null"
          ]
        },
        "settle_ms": {
          "description": "Per-state settle delay in ms overriding the platform's.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "setup": {
          "description": "Setup data used to reach the state.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "TailwindConfig": {
      "additionalProperties": false,
      "description": "The `[tailwind]` table: the config to cross-check and an optional generated theme mapping.\n\nEvery `*_file` key here resolves against the project root, not `css_root`.",
      "properties": {
        "alpha_channels": {
          "default": false,
          "description": "Also emit `-rgb` channel triplets so Tailwind opacity modifiers work.",
          "type": "boolean"
        },
        "config": {
          "default": "",
          "description": "Path of the Tailwind config to cross-check; empty means Tailwind support is off.",
          "type": "string"
        },
        "css_entry": {
          "default": "",
          "description": "Tailwind v4 CSS entry (the file carrying `@import \"tailwindcss\"`); empty means detect.",
          "type": "string"
        },
        "namespace_keys": {
          "default": false,
          "description": "Emit prefix-qualified `theme.extend` keys (`space-4`) instead of bare steps (`4`).",
          "type": "boolean"
        },
        "tokens_file": {
          "default": "",
          "description": "Output path of the generated Tailwind theme mapping; empty means none.",
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/TailwindVersion",
          "default": "auto",
          "description": "Shape of the `config` file."
        }
      },
      "type": "object"
    },
    "TailwindVersion": {
      "description": "Which Tailwind generation the `[tailwind] config` file is written for.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Detect from the file content.",
          "type": "string"
        },
        {
          "const": "v3",
          "description": "A v3 JS config with `theme` and `theme.extend`.",
          "type": "string"
        },
        {
          "const": "v4",
          "description": "A v4 CSS-first config with `@theme`.",
          "type": "string"
        }
      ]
    },
    "TokenPrefixes": {
      "additionalProperties": false,
      "description": "The `[tokens.prefixes]` table: custom-property name prefixes.\n\n`color`, `layer` and `font_family` may be empty (a bare identifier name); the others must be\nnon-empty so numeric steps keep a leading letter. A non-empty prefix matches `[a-z][a-z0-9-]*`.",
      "properties": {
        "color": {
          "default": "color",
          "description": "Prefix of palette color tokens: `--color-ink`.",
          "type": "string"
        },
        "font_family": {
          "default": "font-family",
          "description": "Prefix of font-family tokens: `--font-family-base`.",
          "type": "string"
        },
        "font_size": {
          "default": "font-size",
          "description": "Prefix of font-size tokens: `--font-size-16`.",
          "type": "string"
        },
        "layer": {
          "default": "layer",
          "description": "Prefix of layer (z-index) tokens: `--layer-toast`.",
          "type": "string"
        },
        "radius": {
          "default": "radius",
          "description": "Prefix of radius tokens: `--radius-8`.",
          "type": "string"
        },
        "size": {
          "default": "size",
          "description": "Prefix of size tokens: `--size-32`.",
          "type": "string"
        },
        "space": {
          "default": "space",
          "description": "Prefix of spacing tokens: `--space-4`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Viewport": {
      "additionalProperties": false,
      "description": "A `[[platform]]` web viewport size in CSS pixels.",
      "properties": {
        "height": {
          "description": "Height in CSS pixels, greater than zero.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Width in CSS pixels, greater than zero.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The whole `crunk.toml`, as written. Tables owned by shared crates (`[check]`, `[perf]`, ...)\nare validated by their owners and ignored here.",
  "properties": {
    "breakpoints": {
      "additionalProperties": {
        "description": "Breakpoint width in px.",
        "type": "integer"
      },
      "description": "Viewport name to px, plus `base_required`; optional. Absent with a `[tailwind]` config\ndeclared means the Tailwind v3 defaults; absent entirely means the BP rules are off.",
      "properties": {
        "base_required": {
          "default": [
            "flex",
            "grid",
            "block",
            "hidden",
            "w-",
            "h-",
            "col-",
            "row-"
          ],
          "description": "Layout-critical utility families whose responsive variants demand an unprefixed mobile base (BP002).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "jsx": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsxConfig"
        },
        {
          "type": "null"
        }
      ],
      "description": "JSX ingest; optional."
    },
    "layers": {
      "additionalProperties": {
        "format": "int64",
        "type": "integer"
      },
      "description": "Named z-index layers (`name = <integer>`); optional, absent means LAYER001 is silent.",
      "type": [
        "object",
        "null"
      ]
    },
    "lint": {
      "additionalProperties": false,
      "description": "Per-rule severities (`RULE001 = \"error\" | \"warn\" | \"off\"`), `fix_tolerance` and\n`color_tolerance`; optional.",
      "properties": {
        "BP001": {
          "default": "error",
          "description": "Severity override for this rule.",
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "BP002": {
          "default": "error",
          "description": "Severity override for this rule.",
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "BP003": {
          "default": "error",
          "description": "Severity override for this rule.",
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "COLOR001": {
          "default": "error",
          "description": "Severity override for this rule.",
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "COLOR002": {
          "default": "error",
          "description": "Severity override for this rule.",
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "CONTRAST001": {
          "default": "error",
          "description": "Severity override for this rule.",
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "GALLERY001": {
          "default": "error",
          "description": "Severity override for this rule.",
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "GALLERY002": {
          "default": "error",
          "description": "Severity override for this rule.",
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "GALLERY003": {
          "default": "error",
          "description": "Severity override for this rule.",
          "enum": [
            "error",
            "warn",
            "off"
          ]
        },
        "GALLERY004": {
          "default": "error",
          "description": "Severity override for this rule.",
          "enum": [
            "error",
            "warn",
            "off"
