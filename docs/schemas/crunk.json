      "type": "object"
    },
    "palette": {
      "additionalProperties": {
        "description": "A CSS color literal: hex, rgb(), hsl() or a named color.",
        "type": "string"
      },
      "description": "Named colors (`name = \"<css color>\"`), plus the `[palette.roles]` subtable. Required.",
      "properties": {
        "roles": {
          "additionalProperties": {
            "oneOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "floor": {
                    "default": 4.5,
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  "pair": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                  }
                },
                "required": [
                  "pair"
                ],
                "type": "object"
              }
            ]
          },
          "description": "Role name to a `[foreground, background]` palette-name pair, or a `{ pair = [fg, bg], floor = <n> }` table overriding the contrast floor (default 4.5).",
          "type": "object"
        }
      },
      "type": "object"
