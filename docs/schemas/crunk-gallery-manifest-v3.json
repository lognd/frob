{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crunk.dev/crunk-gallery-manifest-v3.json",
  "title": "crunk gallery manifest v3",
  "description": "Per-state cells with a render and a dated, attributed verdict that can expire.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cells"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "screen",
          "state",
          "platform"
        ],
        "properties": {
          "screen": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "render": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "verdict": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "approved",
                  "rejected"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        }
      }
    }
  }
}
