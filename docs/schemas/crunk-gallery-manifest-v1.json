{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.crunk.dev/crunk-gallery-manifest-v1.json",
  "title": "crunk gallery manifest v1",
  "description": "Screen-level approvals, before states existed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "screen",
          "platform",
          "status"
        ],
        "properties": {
          "screen": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          }
        }
      }
    }
  }
}
