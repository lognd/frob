grimble = "2";
module frob_repo;

/// The ticket goblin.
node frob : trusted {
  kind component;
  clearance Internal;
  owns "crates/frob-*/**";
  owns "crates/frob/**";
}

/// The shared substrate.
node gob : trusted {
  kind component;
  clearance Internal;
  owns "crates/gob-*/**";
}

/// The design goblin.
node grimble : trusted {
  kind component;
  clearance Internal;
  owns "crates/grimble-*/**";
  owns "crates/grimble/**";
}

/// The style goblin.
node crunk : trusted {
  kind component;
  clearance Internal;
  owns "crates/crunk-*/**";
  owns "crates/crunk/**";
}

/// crunk calls the substrate: the check pipeline, the sibling document and the corpus coverage helper (SYS013 edge permission, binding.md B6).
flow crunk_uses_gob : crunk -> gob {
  producer "crates/crunk-check/src/lib.rs";
  consumer "crates/gob-check/src/pipeline.rs";
}
