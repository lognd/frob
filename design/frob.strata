        replace_done_report_section, replay_evidence_from_done_report, resolve_lease, reverify_close_guard, reverify_cmd_evidence, run_cmd_evidence,
        sanitize_narrative_for_ledger, scope_breadth_context, scope_matches, scope_overlap, scope_overlap_globs, set_component,
        set_done_report, set_kind, set_priority, set_scope_breadth_ack, set_sprint, set_tier,
        slugify, splice_ledger, sprint_velocity, sprint_view, sweep_worktrees, ticket_flow,
        ticket_lock, tickets_dir, transition, unbound_acceptance, undispatched_stale, v2_archive_dir,
        v2_attachments_dir, v2_done_report_path, v2_state_transitions, v2_ticket_dir, v2_ticket_path, validate_evidence,
        warn_if_worktree_stale, write_all, write_archive, write_done_report, write_ticket,
    ];
    clearance Internal;
    engine git_tracked;
    append_only;
    code "src/frob/tickets/**";
    may "env" via "src/frob/tickets/_land_git_ops.py", "src/frob/tickets/_leases.py", "src/frob/tickets/_worktree_guard.py", "src/frob/tickets/clipboard.py";
    // `may "eval"`: `_store.py`'s posix-only `fcntl` import goes through
    // `importlib.import_module("fcntl")` (T-0458 ledger_lock) rather than a
    // plain `import fcntl`, so `try`/`except ImportError` can degrade to a
    // documented no-op on a platform lacking the module -- vet's `eval`
    // pattern table fires on `importlib.import_module(` regardless of
    // whether the argument is a runtime string or (as here) a fixed
    // literal; the module name is never attacker-influenceable.
    may "eval" via "src/frob/tickets/_land.py", "src/frob/tickets/_land_queue.py", "src/frob/tickets/_store.py";
    may "exec" via "src/frob/tickets/_evidence.py", "src/frob/tickets/clipboard.py";
    attr flag=frob_check_exec_kill_switch;
    may "fs.write" via "src/frob/tickets/__init__.py", "src/frob/tickets/_brief.py", "src/frob/tickets/_doable.py", "src/frob/tickets/_journal.py", "src/frob/tickets/_land.py", "src/frob/tickets/_land_finalize.py", "src/frob/tickets/_land_git_ops.py", "src/frob/tickets/_land_merge_zones.py", "src/frob/tickets/_land_queue.py", "src/frob/tickets/_leases.py", "src/frob/tickets/_store.py";
    may "fs.read" via "src/frob/tickets/_brief.py", "src/frob/tickets/_journal.py", "src/frob/tickets/_land.py", "src/frob/tickets/_land_finalize.py", "src/frob/tickets/_land_git_ops.py", "src/frob/tickets/_land_merge_zones.py", "src/frob/tickets/_land_queue.py", "src/frob/tickets/_land_release.py", "src/frob/tickets/_land_squash.py", "src/frob/tickets/_leases.py", "src/frob/tickets/_mutation_evidence.py", "src/frob/tickets/_new_gate_rule_acceptance.py", "src/frob/tickets/_new_renumber.py", "src/frob/tickets/_renumber_v2.py", "src/frob/tickets/_reporting_attachments.py", "src/frob/tickets/_store.py", "src/frob/tickets/clipboard.py";
    // T-0166 LINT004: `may "exec"` is a risky capability. T-0200 built a
    // real kill switch and T-0778 wired the git seam (`frob.gitio.
    // run_argv`, which the serve daemon and gitio-based lease reads reuse
    // transitively) through it -- but this node's own `exec` sites (`git
    // ls-files` in `tickets/__init__.py::_repo_files_git`, the
    // shell=True evidence-command spawn, `clipboard.py`'s subprocess.run
    // calls) were wired through the guard by T-0803/T-0805, so the
    // declared flag below is a true statement of switchable capability.
    attr interface=[
        AcceptanceAmendmentEntry, AcceptanceAmendmentOp, AcceptanceCriterion, AttachError, Attachment, AttachmentSource,
        BOARD_STATES, BoardColumn, CLI_WIRING_FILES, CMD_EVIDENCE_ALLOWED_KINDS, ClipboardError, ConfirmatoryFinding,
        DONE_REPORT_HEADING, DRAFT_PREFIX, DROP_REASON_HEADING, DoneReportClaims, EpicRollup, FAILURE_LOG_HEADING,
