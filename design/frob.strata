// frob:doc docs/strata/roadmap.md#self-hosting-commitments-decision-d7
flow f_strata_graphlang : stratamod -> graphlang { label Internal; attr local; }
// frob:doc docs/strata/roadmap.md#self-hosting-commitments-decision-d7
flow f_strata_core : stratamod -> core { label Internal; attr local; }
// strata's `_effects.py` reuses `frob.vet._capability`'s pattern tables
// (docstring, T-0079) -- the one strata -> vet edge.
// frob:doc docs/strata/roadmap.md#self-hosting-commitments-decision-d7
