        "src/frob/release/**" "src/frob/scaffold/**"
        "src/frob/stats/**" "src/frob/bind/**" "src/frob/docs/**"
        "src/frob/fuzz/**" "src/frob/cycle/**" "src/frob/testing/**"
        "src/frob/cve/**" "src/frob/clean/**"
        "src/frob/render/**";
    may "env" via "src/frob/logging/color.py", "src/frob/perf/_harness.py", "src/frob/process/_guard.py", "src/frob/process/_lock.py", "src/frob/render/_color.py", "src/frob/testing/_runners.py";
    may "eval" via "src/frob/dup/_pipeline/_probe.py", "src/frob/fuzz/_signatures.py", "src/frob/perf/_harness.py", "src/frob/process/_lock.py";
    may "exec" via "src/frob/gitio.py", "src/frob/process/_guard.py", "src/frob/testing/_coverage_refresh.py";
    attr flag=frob_check_exec_kill_switch;
    may "fs.write" via "src/frob/clean/_core.py", "src/frob/clean/_rules.py", "src/frob/fuzz/_stamp.py", "src/frob/logging/logger.py", "src/frob/perf/_profile.py", "src/frob/perf/_ratchet.py", "src/frob/policy/__init__.py", "src/frob/process/_lock.py", "src/frob/release/__init__.py", "src/frob/render/_renderer.py", "src/frob/scaffold/_managed.py", "src/frob/scaffold/_pool.py", "src/frob/scaffold/project.py", "src/frob/testing/_collect.py", "src/frob/testing/_collect_shared.py", "src/frob/testing/_coverage_cache.py", "src/frob/testing/_coverage_refresh.py", "src/frob/testing/_coverage_wait.py", "src/frob/testing/_runners.py", "src/frob/testing/_stability.py";
    may "fs.read" via "src/frob/bind/__init__.py", "src/frob/cve/_parser.py", "src/frob/docs/__init__.py", "src/frob/dup/_cache.py", "src/frob/dup/_template.py", "src/frob/fuzz/_stamp.py", "src/frob/gitio.py", "src/frob/map/__init__.py", "src/frob/outline/__init__.py", "src/frob/perf/_profile.py", "src/frob/perf/_ratchet.py", "src/frob/perf/_redundancy.py", "src/frob/perf/_rules.py", "src/frob/policy/__init__.py", "src/frob/release/__init__.py", "src/frob/scaffold/_managed.py", "src/frob/scaffold/_pool.py", "src/frob/stats/_agentic.py", "src/frob/testing/_collect.py", "src/frob/testing/_collect_cpp.py", "src/frob/testing/_collect_rust.py", "src/frob/testing/_collect_shared.py", "src/frob/testing/_collect_ts.py", "src/frob/testing/_coverage_cache.py", "src/frob/testing/_coverage_refresh.py", "src/frob/testing/_coverage_wait.py", "src/frob/testing/_stability.py", "src/frob/xref/__init__.py";
    may "env.read" via "src/frob/testing/_coverage_refresh.py";
    // T-0778: `src/frob/gitio.py`'s own subprocess spawns are now real,
    // wired kill-switch coverage (frob.process._guard.
    // guarded_subprocess_run, transitively covering the serve daemon and
    // gitio-based lease reads too, T-0440: `serve` now calls this code
    // via a flow edge rather than owning it) -- but this node folds in
    // several OTHER packages (gitlog/**, scaffold/**, testing/**) that
    // still call subprocess.run directly, unguarded. Honest remaining
    // gap, not a pending mechanism. Follow-on: T-0803. (T-0440:
    // `mutate`/`deploy` used to be part of this same honest gap while
    // folded into `core` -- both moved onto their OWN nodes below, and
    // both DO route their subprocess spawns through the real,
    // guarded_subprocess_run kill switch already, unlike the packages
    // still listed here.)
    // T-0956/T-1146: same SYS203/tickets_ledger disposition as `cli`
    // above -- SYS203 now genuinely discharges live here too (the
    // `waive "SYS203:tickets_ledger" ...` clause this comment used to
    // justify is REMOVED; see `cli`'s full comment above for the
    // reasoning).
    access "tickets_ledger" mode write;
    // T-1158: SYS205 WRITE path-scoping now discharges cleanly via a
    // real owns= claim -- T-1164 fixed the blast-radius false positive
    // this declaration would otherwise have triggered (bare runs_as=None
    // treated as a compromised-user identity), and T-1146/T-1149 wired
    // module= into the live check_resource_contention call so SYS201
    // stays arbiter-aware for this owns= claim (tickets_ledger's shared
    // lock, verified: `frob sys audit` clean with no new SYS201/SYS205
    // findings). The `waive "SYS205:tickets_ledger" ...` clause this
    // comment used to justify is REMOVED.
    owns "tickets.md" "0644";
}

// T-0440: `frob mutate` -- mutation testing, the honest test-quality
// oracle (src/frob/mutate/__init__.py, T-0011). Split off `core`'s
// former utility-hub node because its real threat surface is distinct:
// it is the one non-`checker`/`vet`/`fleet` component that spawns a
// subprocess whose ARGV embeds a caller-supplied test command
// (`run_mutations`'s `test_argv` parameter), against a source tree it
// has just mutated on disk -- a narrower, more specific CWE-78 exposure
// than the generic "dense utility mesh" framing gave it credit for.
// `may` measured by `frob.strata._effects._line_effects` /
// `frob.vet._capability._scan_directory_capabilities` against
// `src/frob/mutate/**` (T-0440 Done report): `fs.write` (`_run_mutants`'s
// `target.write_text` of each mutant, restored via the same call in the
// `finally` block) + `fs.read` (`run_mutations`'s `target.read_text` of
// the original source) + `exec` (`_run_mutants`'s
// `guarded_subprocess_run` call, imported from `frob.process._guard`
// inside `_run_mutants` itself -- deferred, but still a real, observed
// `subprocess.` site in this file's own text, hence declared here rather
// than left as an undeclared cross-node effect). No `eval`/`net`/`ffi`/
// `sql`/`fetch_url`/`deserialize`/`env` observed anywhere in this
// package. The exec capability has a REAL, wired kill switch already:
// `run_mutations`'s own module docstring (T-0803) documents that a
// `guarded_subprocess_run` refusal (`FROB_DISABLE_EXEC=1`) aborts the
// WHOLE run with `Err(MutateError.ExecDisabled)` rather than silently
// mis-scoring the refused mutant as "killed" -- the same
// `frob_check_exec_kill_switch` identifier every other
// `guarded_subprocess_run` caller in this model already names, since
// it is the SAME env var / mechanism (`frob.process._guard.
// EXEC_KILL_SWITCH_ENV`), not a second one.
// T-0860: `may "env"` ADDED -- `_run_mutants`'s `child_env = {**os.environ,
// MUTATION_RUN_ENV: "1"}` reads the whole parent environment to build the
// mutant subprocess's own env, a genuine (not false-positive) `os.environ`
// site that postdates the T-0440 survey above and was never folded back
// into this node's declared capability set, tripping SYS100 (`env`
// observed but undeclared). No further "No `eval`/`net`/`ffi`/`sql`/
// `fetch_url`/`deserialize` observed" claim above is affected -- this is
// the one addition.
// frob:doc docs/modules/mutate.md#public-api
// frob:ticket T-0860
// frob:waive AFFECT001 reason="T-1113: mechanical interface= attr population \
// (measured public-surface metadata for the new mandatory SYS104 check), not a \
// behavioral/architectural change -- the cited affects()-closure doc does not \
// describe this node's public surface and has nothing to update here."
node mutate : trusted {

    attr interface=[
        JournalError, MUTATION_RUN_ENV, Mutant, MutateError, MutationResult, StaleJournal,
        generate_mutants, list_stale_journals, record_journal_progress, remove_journal, restore_stale_journals, run_mutations,
        write_journal,
    ];
    clearance Internal;
    code "src/frob/mutate/**";
    may "exec";
    attr flag=frob_check_exec_kill_switch;
    may "fs.write";
    may "fs.read";
    may "env";
}

// T-1329: `frob.refactor` -- the T-1197 reference-rewrite engine
// (resolve/plan/apply/verify transactional pipeline). Landed without a
// node binding (SYS102 + 4x SYS103 foreign fs capabilities, found by
// T-1203's audit agent and re-confirmed by the T-1320 coverage run's
// selfconform failures). `may` measured against the SYS103 findings:
// `fs.read` (_resolve/_scan/_verify read source files to resolve and
// verify rewrites) + `fs.write` (_apply writes the rewritten files --
// the whole point of the engine). Git transaction commands route
// through `frob.gitio.run_argv` (the `core` node's own exec capability,
// reached via flow, not this node's) -- same "code owns the effect"
// shape as mutate/natives above. Own node rather than folded into cli:
// the CLI wiring for this package is deliberately unbuilt (TEST003
// waiver on its interface node documents that), so the package IS the
// capability boundary.
// frob:doc docs/commands/refactor.md#public-api
// frob:ticket T-1329
// frob:ticket T-1267
node refactor : trusted {

    attr interface=[
        RefactorError, RefactorKind, RefactorPlan, ResolvedSymbol, RewriteOp, SymbolRef,
        add_refactor_parser, apply_plan, build_move_ops, build_plan, build_reexport_shim_op, carry_lock_acks,
        chunk_symbols, current_sha, extend_span_for_attached_directives, find_python_files, module_to_path, resolve_rename_dest_collision,
        resolve_symbol, run_refactor, run_refactor_command, run_split, scan_directive_carriers, scan_doc_anchor_carriers,
        scan_docs_prose_mentions, scan_evidence_citations, scan_pii_allowlist_carrier, scan_python_prose_mentions, scan_references, scan_registry_citations,
        verify_check_delta, verify_import_resolution, verify_pytest_collect, working_tree_clean,
    ];
    clearance Internal;
    code "src/frob/refactor/**";
    may "fs.read";
    may "fs.write";
}

// T-0864: `frob natives build` -- frob-owned `maturin develop` per
// declared `[[native]]` rust crate, sharing one git-common-dir-keyed
// `CARGO_TARGET_DIR` (T-0732's verified design, moved out of this repo's
// own Makefile). `may` measured directly against `src/frob/natives/**`:
// `exec` (`build_natives`'s own `guarded_subprocess_run` call spawning
// `uvx maturin develop`, the same real, wired `frob_check_exec_kill_switch`
// mechanism every other `guarded_subprocess_run` caller in this model
// already names) + `env` (`os.environ.copy()` to build the maturin
// subprocess's own env with `VIRTUAL_ENV`/`CARGO_TARGET_DIR` overlaid). No
// `fs.write`/`fs.read`: `_crate_dir_for`'s `Path.is_file()` is a plain
// existence stat, never an actual file open/read -- the real
// `frob.toml`/crate-tree reads are `frob.testing._runners.load_natives`'s
// own `core`-node capability, reached via the `f_natives_core` flow
// below, not this node's own effect. No `eval`/`net`/`ffi`/`sql`/
// `fetch_url`/`deserialize` observed either. Split onto its own node
// rather than folded into `cli` (which already owns
// `src/frob/app/natives_runner.py` via its `src/frob/app/**` glob) --
// same "code owns the effect, not its caller" shape as
// `mutate`/`deploy`/`serve` above: the CLI wiring is a thin dispatcher,
// this package is where the real capability lives.
// frob:doc docs/modules/cli.md#frob-natives-build-t-0864
// frob:ticket T-0864
// frob:waive AFFECT001 reason="T-1113: mechanical interface= attr population \
// (measured public-surface metadata for the new mandatory SYS104 check), not a \
// behavioral/architectural change -- the cited affects()-closure doc does not \
// describe this node's public surface and has nothing to update here."
node natives : trusted {

    attr interface=[
        BuildReport, CrateBuildResult, NativesError, build_natives,
    ];
    clearance Internal;
    code "src/frob/natives/**";
    may "exec";
    attr flag=frob_check_exec_kill_switch;
    may "env";
}

// T-0440: `frob serve` -- the MCP adapter exposing frob's enforcement
// queries over stdio (src/frob/serve/**, docs/modules/serve.md). Split
// off `core`'s former utility-hub node because it is the ONE component
// in this whole model an external MCP CLIENT PROCESS talks to directly
// (`server.py`'s stdio `FastMCP` transport, `run_stdio`) -- a real,
// previously-undeclared boundary the coarse hub framing hid entirely, no
// different in kind from `registry` being the network boundary `vet`
// crosses. Every filesystem read (`.frob/cache.db`), git subprocess call
// (`_daemon.py`'s `poll_rebase_bot`), and gate/graph/ticket read this
// component performs beyond the two capabilities below is delegated to
// `frob.graph`/`frob.gates`/`frob.gitio`/`frob.testing`/`frob.tickets`
// code that lives on OTHER nodes -- modeled below as real flow edges into
// `core`/`gates`/`graphlang`/`tickets_ledger`, not as `serve`'s own
// capabilities (the same "code owns the effect, not its caller"
// discipline `core`'s `f_core_tickets` comment already documents).
// T-1092: `serve` is no longer a zero-`may` node. `frob.serve._socketd`
// (T-1092, docs/modules/serve.md#socket-daemon-t-1092) adds the module's own
// first genuine effects, both bound to `src/frob/serve/**` itself, not
// delegated to another node: (1) `fs.write` -- `acquire_singleton_lock`/
// `run_socket_daemon` create/write `.frob/daemon.lock` and bind/unlink
// `.frob/daemon.sock` directly (`_socketd.py`'s `open`/`Path.unlink`/
// socket-bind calls); (2) `net` -- the unix-domain-socket transport
// itself (`_DaemonServer`'s `ThreadingUnixStreamServer` bind/accept loop
// and `send_request`'s client `socket.socket(AF_UNIX, ...)` connect) is a
// listening/connecting socket capability, `net.connect`/`net.listen` in
// `frob.vet._capability`'s vocabulary, even though `AF_UNIX` never leaves
// the local filesystem namespace -- no kill switch is wired for either
// (unlike `vet`'s `frob_vet_net_kill_switch` below): a project-local unix
// socket used only for `frob.serve._tools`'s own read-only enforcement
// queries carries none of `vet`'s external-network-egress risk profile
// that motivated that switch.
// frob:doc docs/strata/roadmap.md#self-hosting-commitments-decision-d7
// frob:doc docs/modules/serve.md#socket-daemon-t-1092
// frob:ticket T-0956
// frob:ticket T-1092
// frob:waive AFFECT001 reason="T-1113: mechanical interface= attr population \
// (measured public-surface metadata for the new mandatory SYS104 check), not a \
// behavioral/architectural change -- the cited affects()-closure doc does not \
// describe this node's public surface and has nothing to update here."
node serve : trusted {

    attr interface=[
        DaemonError, McpUnavailable, ResourceLeaseManager, ServeError, SocketDaemonConfig, WatchThread,
        _EventBus, acquire_singleton_lock, build_server, dispatch_request, frob_affects, frob_check_delta,
        frob_check_scope, frob_daemon_status, frob_doable_tickets, frob_doc_for, frob_graph_query, frob_perf_hot,
        frob_run_touched_tests, frob_stale_docs, lock_path, run_socket_daemon, run_stdio, send_request,
        socket_path, subscribe_and_wait, watch_tick,
    ];
    clearance Internal;
    code "src/frob/serve/**";
    may "fs.write";
    may "net";

    // T-0756: same SYS203/tickets_ledger disposition as `cli`/`gates`/
    // `fleet`/`core` above (T-0724) -- `serve` also has a Flow into
    // `tickets_ledger` (`f_serve_tickets` below) via `frob.tickets`'s own
    // locked writer path, so SYS203's mode-blind "any inbound flow counted
    // as a write" join fires here too.
    // T-0956/T-1146: same SYS203/tickets_ledger disposition as `cli`
    // above -- SYS203 now genuinely discharges live here too (the
    // `waive "SYS203:tickets_ledger" ...` clause this comment used to
    // justify is REMOVED; see `cli`'s full comment above for the
    // reasoning).
    access "tickets_ledger" mode write;
    // T-1158: SYS205 WRITE path-scoping now discharges cleanly via a
    // real owns= claim -- T-1164 fixed the blast-radius false positive
    // this declaration would otherwise have triggered (bare runs_as=None
    // treated as a compromised-user identity), and T-1146/T-1149 wired
    // module= into the live check_resource_contention call so SYS201
    // stays arbiter-aware for this owns= claim (tickets_ledger's shared
    // lock, verified: `frob sys audit` clean with no new SYS201/SYS205
    // findings). The `waive "SYS205:tickets_ledger" ...` clause this
    // comment used to justify is REMOVED.
    owns "tickets.md" "0644";
}

// T-0440: `frob deploy` -- compiles `std.host` manifests into idempotent
// install/status/uninstall automation (bash + PowerShell/DSC) and runs
// the `frob deploy audit --vm` snapshot-diff harness against a live
// target host over ssh/VBoxManage (src/frob/deploy/**, deploy epic
// T-0254). Split off `core`'s former utility-hub node because its real
// threat surface is distinct from the rest of that mesh: it is the one
// component whose generated OUTPUT is itself install/uninstall
// automation meant to run with host-admin privilege on a REMOTE target,
// and whose own `_vm_runner.py` spawns `ssh`/`VBoxManage` subprocesses
// against that target directly.
// `may` measured by `frob.strata._effects._line_effects` /
// `frob.vet._capability._scan_directory_capabilities` against
// `src/frob/deploy/**` (T-0440 Done report): `fs.write` (`_drift.py`'s
// `toml_path.open("rb")` -- the scanner's `open(`-shaped needle is
// bucketed under the write-derived kind regardless of open mode, same
// precision note `registry_model`/`fleet` above already document) +
// `fs.read` (`_drift.py`'s `committed_path.read_text`) + `exec`
// (`_vm_runner.py`'s
// `_run_guarded`, routed through `guarded_subprocess_run` -- the SAME
// real, wired `frob.process._guard.EXEC_KILL_SWITCH_ENV` kill switch
// every other `guarded_subprocess_run` caller in this model names via
// `frob_check_exec_kill_switch`). `may "eval"` is deliberately NOT
// declared: the scanner's bare-`eval(`-shaped needle matches
// `_conform.py::_mutation_for_eval`'s own PYTHON FUNCTION NAME (the
// substring "eval(" inside the identifier `_mutation_for_eval(`), not a
// call to the `eval`/`exec` builtins -- the exact T-0151-class
// self-match false positive `gates`'s own header comment above already
// documents for a different needle (`compile(`); direct grep of
// `src/frob/deploy/**` confirms zero real `eval(`/`exec(` builtin calls
// anywhere in this package, so declaring `may "eval"` here would be an
// unfalsifiable claim SYS101 exists to catch, not an honest one. No
// `net`/`ffi`/`sql`/`fetch_url`/`deserialize`/`env` observed either --
// the ssh/VBoxManage calls are modeled as `exec` (a local subprocess
// spawn), the same convention `fleet`'s ssh-adjacent git/uv subprocess
// calls above already use, not as a separate `net` capability.
// T-0882: the T-0860 waiver below is REMOVED -- `frob.vet._capability`'s
// scanner (`_needle_hits_as_bare_call`/`_BARE_CALL_NEEDLES`) no longer
// treats `eval(`/`exec(` as a plain substring, so it no longer self-matches
// `_conform.py::_mutation_for_eval`'s own function name (the identifier
// merely ENDS in the text "eval(", it is not a bare builtin call site).
// frob:doc docs/strata/roadmap.md#self-hosting-commitments-decision-d7
// frob:ticket T-0860
// frob:waive AFFECT001 reason="T-1113: mechanical interface= attr population \
// (measured public-surface metadata for the new mandatory SYS104 check), not a \
// behavioral/architectural change -- the cited affects()-closure doc does not \
// describe this node's public surface and has nothing to update here."
node deploy : trusted {

    attr interface=[
        AuditAttestation, AuditRunResult, CheckpointResult, FileFact, MutationTarget, StateCapture,
        VmAuditConfig, artifact_freeness_holds, assert_healthy, assert_not_installed, build_attestation, deploy_conformance_violations,
        deploy_drift_violations, diff_states, expected_mutation_surface, extract_mutation_surface, generate_all, generate_install_script,
        generate_status_script, generate_uninstall_script, generate_windows_install_script, generate_windows_status_script, generate_windows_uninstall_script, idempotence_holds,
        install_exactness_holds, manifest_digest, run_vm_audit, sorted_manifest_entries, vboxmanage_available, windows_entries,
    ];
    clearance Internal;
    code "src/frob/deploy/**";
    may "exec";
    attr flag=frob_check_exec_kill_switch;
    may "fs.write";
    may "fs.read";
}

// vet: src/frob/vet/**. Dependency-vetting -- the ONE component that
// crosses the trust boundary out to `registry` (network fetches for
// publish dates, OSV advisories, popularity data).
// T-0158: `may "fetch_url"` added -- urlopen-shaped URL fetches
// (_nvd.py/_registry.py), a real observed capability the old coarser
// pattern table never patterned, not new code.
// T-0201: `may "deserialize"`/`may "eval"`/`may "exec"`/`may "sql"`
// REMOVED. A T-0150-round-2 prototype (reverted at the time) first showed
// these four only ever fired via `_capability.py`/`_capability_registry.py`/
// `_cve_fingerprint.py` scanning THEIR OWN needle-literal tables -- the
// T-0151 self-match class, not real vet code exercising the capability
// (`_pickle_violation` in `_ecosystem.py` DETECTS shipped pickle files by
// extension, it never itself calls `pickle.load`; `conn.execute(...)` in
// `_cache.py`/`_nvd.py`/`_registry.py` is parameterized, not the
// string-formatted `execute(f"...")` shape the `sql` needle patterns for;
// no `eval`/`exec` call exists anywhere under `src/frob/vet/**` outside
// the excluded catalog files). Once T-0201's shared `is_self_pattern_path`
// exclusion (`frob.vet._capability`) is applied consistently in BOTH vet
// aggregation and every `frob.strata._selfconform`/`_effects` join path,
// a clean self-conformance scan confirms zero real sites for these four --
// they were never genuinely exercised capabilities, so removing them is
// the honest fix, not a coverage regression.
// T-0822 (closing T-0155's honest LINT004 gap, same disposition
// as `checker` above; supersedes T-0803's still-unwired disposition and
// the never-filed "T-0817" waiver id a stale dispatch prompt referenced):
// `may "net"` now has a REAL, checked-in kill switch --
// `frob.process.net_enabled()` (`FROB_DISABLE_NET`, T-0200's mechanism,
// unused pending a real call site until this ticket wired it). Both of
// vet's own `urlopen` sites (`_registry.py::_result_from_network`,
// `_nvd.py::_fetch_from_network`) check `net_enabled()` before ever
// opening a socket and degrade exactly like a network failure
// (`ok=False`) when disabled -- live and without a redeploy
// (`tests/test_vet.py::TestRegistryLookup`), not an aspirational claim
// (T-0150/T-0151 discipline), so the T-0174 `waive "LINT004"` is retired
// in favor of the real declaration below.
// frob:doc docs/strata/roadmap.md#self-hosting-commitments-decision-d7
// frob:waive AFFECT001 reason="T-1113: mechanical interface= attr population \
// (measured public-surface metadata for the new mandatory SYS104 check), not a \
// behavioral/architectural change -- the cited affects()-closure doc does not \
// describe this node's public surface and has nothing to update here."
// frob:ticket T-1433
node vet : trusted {

    attr interface=[
        CAPABILITY_KINDS, CAPABILITY_MATRIX_EXCUSES, CAPABILITY_MODE_KINDS, CONTAINED, CapabilityModeError, ContainmentFinding,
        ContainmentReport, CveMatch, CweDisposition, CweLink, DANGEROUS_OPERATIONS, Dependency,
        FAMILY_MODES, HookVerdict, ImportResolution, LANGUAGES, LEGACY_CAPABILITY_ALIASES, LIVE,
        MatchStatus, OPAQUE_SOURCE_INVISIBLE, OsvAdvisory, PROC_FAMILY_SCANNER_KIND, PackageVerdict, RUNTIME_OPAQUE_STRUCTURAL_CONSTRUCTS,
        SCANNED_LANGUAGES, UNMODELED, UNVERIFIED, VetError, VetReport, _DangerousOperation,
        _RegistryResult, _SPECIAL_CHECKS, _arg_looks_literal, _damerau_levenshtein, _decode_to_exec_signal, _fetch_publish_date,
        _find_all_lockfiles, _find_lockfile, _find_typosquat, _hex_identifier_ratio_signal, _high_entropy_strings, _invisible_text_signal,
        _latest_verdict, _load_vet_config, _locate_cargo_source, _locate_npm_source, _locate_pypi_source, _locate_source,
        _mode_qualified, _normalize_observed_kind, _opaque_indirection_findings, _parse_lockfile, _scan_directory_capabilities, _scan_directory_fingerprints,
        _scan_directory_obfuscation, _scan_file_fingerprints, _scan_file_operations, _scan_lifecycle_scripts, _scan_text_obfuscation, _split_top_level_args,
        _unexcused_empty_cells, _validate_registry_kinds, build_containment_report, canonical_declared_kind, capability_diff, capability_matrix,
        check_package, closed_world_accounting, cve_ids, expand_declared_kind, fetch_cwe_for_cve, find_importing_nodes,
        is_self_pattern_path, language_for, link_cwe_ids, match_dependencies_against_mirror, non_executable_line_numbers, parse_hook_command,
        render_containment_report, resolve_capability_kind, resolve_import, scan_file_capabilities, scan_tree, taint_findings,
        ttl_cache_set, walk_python_imports,
    ];
    clearance Internal;
    code "src/frob/vet/**";
    may "env" via "src/frob/vet/_source.py";
    may "fetch_url" via "src/frob/vet/_nvd.py", "src/frob/vet/_registry.py";
    may "ffi" via "src/frob/vet/_popular_pypi.py";
    may "fs.write" via "src/frob/vet/_nvd.py", "src/frob/vet/_registry.py";
    may "fs.read" via "src/frob/vet/_allow.py", "src/frob/vet/_closedworld.py", "src/frob/vet/_containment.py", "src/frob/vet/_ecosystem.py", "src/frob/vet/_lifecycle.py", "src/frob/vet/_lockfile.py", "src/frob/vet/_obfuscation.py", "src/frob/vet/_scan.py", "src/frob/vet/_supplychain.py", "src/frob/vet/_taint.py";
    may "install-hook" via "src/frob/vet/_ecosystem.py";
    may "net" via "src/frob/vet/_popular_npm.py";
    attr flag=frob_vet_net_kill_switch;
}

// The ticket ledger: tickets.md + tickets/, git-tracked truth.
// `code "src/frob/tickets/**"` (T-0166 un-fold): `store_prop` in
// `strata-core/src/parse.rs::parse_store` used to reject `code`/`may` (the
// real, narrow gap T-0150 found and worked around by folding this code
// into `core` instead); T-0166 fixed the grammar (mirrors `node`'s
// `code`/`may`, docs/strata/surface.md#node-grammar-implemented), so the
// ledger's own code now binds here, where it honestly belongs, rather
// than on a neighboring node. `may` was measured the same honest way the
// module docstring's header describes for every other node/store here
// (`frob.vet._capability.scan_directory_capabilities` against
// `src/frob/tickets/**`: `env` (`clipboard.py` env probing),
// `exec` (`clipboard.py`'s `subprocess.run` calls to `wl-paste`/platform
// clipboard tools), `fs.write` (`_store.py`/`_land.py` ledger file writes) --
// zero `eval`/`net`/`ffi` observed). `core`'s existing
// `f_core_tickets: core -> tickets_ledger` flow (and the cli/gates
// equivalents) still model the real cross-component calls INTO this
// code, unchanged by where the code itself is bound; `append_only`
// because the ledger is edited by appending new tickets and updating
// ticket bodies in place under git history, never by deleting the record
// of what happened (archive moves closed tickets to a separate tracked
// file, `write_archive`, rather than erasing them).
// frob:doc docs/strata/roadmap.md#self-hosting-commitments-decision-d7
// frob:waive AFFECT001 reason="T-1113: mechanical interface= attr population \
// (measured public-surface metadata for the new mandatory SYS104 check), not a \
// behavioral/architectural change -- the cited affects()-closure doc does not \
// describe this node's public surface and has nothing to update here."
// frob:ticket T-1518
// frob:ticket T-1687
// frob:ticket T-1727
store tickets_ledger : trusted {
    may "env.read" via "src/frob/tickets/_land.py";

    attr interface=[
        AcceptanceAmendmentEntry, AcceptanceAmendmentOp, AcceptanceCriterion, Attachment, AttachmentSource, BOARD_STATES,
        CLI_WIRING_FILES, CMD_EVIDENCE_ALLOWED_KINDS, ClipboardError, ConfirmatoryFinding, DRAFT_PREFIX, DoneReportClaims,
        FROB_AGENT_ENV, FROB_WORKTREE_ENV, FailureEntry, GateRuleRegistryUnresolvable, LAND_LOCK_REL, LEASE_TTL_SECONDS,
        LandError, LandLockTimeout, LandReport, LeaseError, MutationEvidenceError, Origin,
        PRIORITY_RANK, Priority, ProfileName, QueueEntry, QueueError, RenumberReport,
        ReviewEntry, ReviewVerdict, ScopeChangeOp, SprintTransition, SprintVelocityReport, Stride,
        Ticket, TicketError, TicketFlowReport, TicketFlowRow, TicketKind, TicketQueue,
        TicketSpec, TicketState, TicketTier, WorktreeInUseError, _archived_ids, _deletion_owned,
        _validate_closeable, add_acceptance, add_cmd_evidence, add_evidence, agent_env_exports, allocator_lock,
        amend_acceptance, archive, archive_digest_map, archive_path, atomic_write, attach,
        attachments_dir, base_ref_resolvable, board_view, brief_cluster, brief_ticket, check_ticket_mutation_evidence,
        clipboard_has_image, clipboard_image, cluster_descendants, cluster_union_scope, commit_full_ledger_change, commit_start_transition,
        commit_ticket_ledger_change, compose_done_report, compute_changed_lines, configured_profile, describe_root_dirt, dispatch_stale_hours,
        display_state, doable, doable_blocked, downgrade_profile_ratchet, drain_next, drop_ticket,
        effective_profile, enforce_worktree_lease, enqueue, enqueue_pending_sweep, epic_rollup, file_lock,
        finalize_draft, finalize_draft_for_land, has_approved_review_for_commit, has_live_lease, has_substantive_done_report, is_cmd_evidence,
        is_draft_id, is_lease_ttl_expired, is_valid_ticket_ref, iter_raw_ledger_frontmatter, land, land_plan,
        large_glob_warnings, lease_age_seconds, leased_by, leases_dir, ledger_digest, ledger_digest_map,
        ledger_lock, ledger_path, live_tracker_citations, load_active, load_all, load_archive,
        load_positive_int_config, load_queue, load_require_review_for_close, matches_collected, migrate, migrate_to_ledger,
        migrate_v1_to_v2, mint_draft_id, missing_acceptance_for_new_rules, mutate_labels, mutate_scope, new_gate_rule_ids,
        new_ticket, on_default_branch, parse_claims_from_done_report, pending_sweep_count, queue_status, read_all_leases,
        read_done_report, reconcile, record_failure, record_lease, record_rapid_debt, record_review,
        recover_done_report_why, refuse_if_land_in_progress, refuse_if_worktree_in_use, release_lease, remove_acceptance, rename_lease,
        render_changed_block, render_claims_block, render_evidence_block, renumber, renumber_one, replace_done_report_section,
        replace_evidence, replay_evidence_from_done_report, resolve_lease, reverify_close_guard, reverify_cmd_evidence, run_cmd_evidence,
        run_pending_sweep, sanitize_narrative_for_ledger, scan_for_live_worktree_process, scope_breadth_context, scope_matches, scope_overlap,
        scope_overlap_globs, set_component, set_designated_repro_test, set_done_report, set_kind, set_priority,
        set_scope_breadth_ack, set_sprint, set_tier, slugify, splice_ledger, sprint_velocity,
        sprint_view, sweep_worktrees, ticket_flow, ticket_lock, tickets_dir, transition,
        unbound_acceptance, undispatched_stale, v2_archive_dir, v2_attachments_dir, v2_done_report_path, v2_state_transitions,
        v2_ticket_dir, v2_ticket_path, validate_evidence, warn_if_worktree_stale, write_all, write_archive,
        write_archived_ticket, write_done_report, write_json_records, write_ticket,
    ];
    clearance Internal;
    engine git_tracked;
    append_only;
    code "src/frob/tickets/**";
    may "env" via "src/frob/tickets/_land_git_ops.py", "src/frob/tickets/_leases.py", "src/frob/tickets/_mutation_evidence.py", "src/frob/tickets/_worktree_guard.py", "src/frob/tickets/clipboard.py";
    // `may "eval"`: `_store.py`'s posix-only `fcntl` import goes through
    // `importlib.import_module("fcntl")` (T-0458 ledger_lock) rather than a
    // plain `import fcntl`, so `try`/`except ImportError` can degrade to a
    // documented no-op on a platform lacking the module -- vet's `eval`
    // pattern table fires on `importlib.import_module(` regardless of
    // whether the argument is a runtime string or (as here) a fixed
    // literal; the module name is never attacker-influenceable.
    may "eval" via "src/frob/tickets/_land.py", "src/frob/tickets/_land_queue.py", "src/frob/tickets/_store.py";
    may "exec" via "src/frob/tickets/_evidence.py", "src/frob/tickets/clipboard.py";
    attr flag=frob_check_exec_kill_switch;
    may "fs.write" via "src/frob/tickets/__init__.py", "src/frob/tickets/_brief.py", "src/frob/tickets/_doable.py", "src/frob/tickets/_evidence.py", "src/frob/tickets/_journal.py", "src/frob/tickets/_land.py", "src/frob/tickets/_land_finalize.py", "src/frob/tickets/_land_git_ops.py", "src/frob/tickets/_land_merge_zones.py", "src/frob/tickets/_land_queue.py", "src/frob/tickets/_leases.py", "src/frob/tickets/_mutation_sweep_queue.py", "src/frob/tickets/_profile.py", "src/frob/tickets/_store.py";
    may "fs.read" via "src/frob/tickets/_brief.py", "src/frob/tickets/_evidence.py", "src/frob/tickets/_journal.py", "src/frob/tickets/_land.py", "src/frob/tickets/_land_finalize.py", "src/frob/tickets/_land_git_ops.py", "src/frob/tickets/_land_merge_zones.py", "src/frob/tickets/_land_queue.py", "src/frob/tickets/_land_release.py", "src/frob/tickets/_land_squash.py", "src/frob/tickets/_leases.py", "src/frob/tickets/_mutation_evidence.py", "src/frob/tickets/_mutation_sweep_queue.py", "src/frob/tickets/_new_gate_rule_acceptance.py", "src/frob/tickets/_new_renumber.py", "src/frob/tickets/_profile.py", "src/frob/tickets/_renumber_v2.py", "src/frob/tickets/_reporting_attachments.py", "src/frob/tickets/_store.py", "src/frob/tickets/clipboard.py";
    // T-0166 LINT004: `may "exec"` is a risky capability. T-0200 built a
    // real kill switch and T-0778 wired the git seam (`frob.gitio.
    // run_argv`, which the serve daemon and gitio-based lease reads reuse
    // transitively) through it -- but this node's own `exec` sites (`git
    // ls-files` in `tickets/__init__.py::_repo_files_git`, the
    // shell=True evidence-command spawn, `clipboard.py`'s subprocess.run
    // calls) were wired through the guard by T-0803/T-0805, so the
    // declared flag below is a true statement of switchable capability.
}

// T-0956: names the SAME single-writer arbiter the five SYS203/
// tickets_ledger waivers above have described in prose since T-0724 --
// the `.frob/tickets.lock` flock every ledger writer serializes through
// (T-0458/T-0633) -- as an actual model-level `resource`/`access` fact
// now that T-0700 shipped the grammar. `lock "tickets.lock"` (not
// `arbitrated_by`) because the real arbiter is a flock file, not a node
// that itself performs the arbitration; SYS204's `resource_contention_
// violations` (`src/frob/strata/_access.py`) treats a declared `lock` the
// same as `arbitrated_by` -- either discharges every conflicting access
// pair for the resource. Verified directly against frob's own elaborated
// design (T-0956 Done report): with this resource plus the five `access
// "tickets_ledger" mode write;` clauses below, `resource_contention_
// violations(elaborated_frob_module)` returns empty for `tickets_ledger`
// -- the model-level contention SYS204 would otherwise flag among
// cli/gates/core/serve/fleet's five write-mode accessors is cleanly
// discharged by the declared lock, matching the flock's real behavior.
// frob:doc docs/strata/host.md#resource-access-modes-t-0700
// frob:ticket T-0956
// frob:tests \
// tests/system/test_frob_self_model.py::TestFrobSelfModel.test_sys_gate_zero_violations
resource tickets_ledger {
    lock "tickets.lock";
}

// The `.frob/` symbol-graph cache (`frob.graph`'s snapshot cache): derived
// entirely from a `graphlang` parse and invalidated by the next one, never
// hand-edited -- staleness is bounded by "no parse has happened since the
// last one", modeled here as a 1s ttl (parse-triggered invalidation is
// effectively immediate, not time-based, but the cache sugar requires a
// bound and 1s documents "as fresh as the last parse" without claiming a
// false 0).
// frob:doc docs/strata/roadmap.md#self-hosting-commitments-decision-d7
cache graph_cache of graphlang {
    ttl 1 s;
    invalidate_on f_parse;
}

// -- support trees (T-1079, SYS103's 264-finding follow-up) -------------
//
// T-0667 shipped SYS103 (SYS-COV, "every capable file has an owning
// node") but scoped its live gate wiring to `_PACKAGE_ROOT` ("src/frob")
// specifically so it would not regress `SELFAUDIT001` from green to 264
// errors on day one (docs/modules/strata.md's SYS103 "Known gap" -- the
// unrestricted, repo-wide scan surfaces 264 real unbound-but-capable
// findings under `tests/**`, `scripts/**`, `frob-core/src/**`, and
// `strata-core/src/**`, none of which this model ever declared `code=`
// for). This ticket closes that gap honestly by binding all four trees
// to real nodes below -- every one of them genuinely exercises real
// capabilities (test fixtures spawn subprocesses and write files; the
// release script edits pyproject.toml; the two Rust crates cross the
// FFI boundary into the Python interpreter), so "reasoned exclusion"
// would be dishonest here -- these are not inert data, they are capable
// code with no prior owner. `may` measured directly against
// `frob.vet._capability.scan_file_capabilities`'s own per-file output
// for the unrestricted SYS103 scan (T-1079 Done report has the exact
// counts): each kind below is a kind this ticket's own scan actually
// observed under the tree, never a guessed/aspirational one. T-0717:
// the scanner's `fs-write`/`fs-read` kinds now normalize to the precise
// mode-qualified `fs.write`/`fs.read` spellings (no more folding to a
// bare `fs` kind); `env-read`/`env-write` and `net-connect` still fold
// to the bare `env`/`net` kind every other node in this file already
// declares, unaffected by this ticket's fs-only migration.

// The test suite itself: `tests/**`. By far the largest of the four
// trees (262 of 264 findings) and, by construction, the one exercising
// the widest capability surface in this whole model -- it is the only
// code whose entire job is to prove every OTHER node's capability
// claims, so it legitimately touches nearly every kind SYS100/SYS101
// know about: `env`/`eval`/`exec` (subprocess-spawning CLI-dispatch
// tests, `os.environ` monkeypatching), `fetch_url`/`net` (httpx/network
// mock tests for `vet`'s registry client), `ffi` (native-extension
// tests against `strata_core`/`frob_core`), `fs.write`/`fs.read` (fixture
// files, tmp_path-based ledger/config round-trips), `install-hook` (git
// hook scaffolding tests), `sql` (cache/db tests), `deserialize`
// (pickle/CVE-fixture parsing tests in `tests/unit/cve/**`). Declaring
// all of them here is the honest statement that this tree's job REQUIRES
// touching every capability the product itself has, not an
// under-specified catch-all.
// frob:doc \
// docs/modules/strata.md#modeled-_package_root-restrictions-264-finding-follow-up-t-10\
// 79-closed
// frob:ticket T-1253
// frob:ticket T-1227
// frob:ticket T-1262
// frob:ticket T-1263
// frob:ticket T-1340
// frob:ticket T-1363
// frob:ticket T-1384
// frob:ticket T-1410
// frob:ticket T-1433
// frob:ticket T-1267
// frob:ticket T-1548
// frob:ticket T-1501
// frob:ticket T-1518
// frob:ticket T-1687
