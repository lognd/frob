// gates: src/frob/gates/**. The obligation-graph rule engine (SYS/DRIFT/
// COV/task-tracking/etc.); reads graph+lang's snapshot and strata's design models,
// writes nothing on its own (violations are reported, not auto-filed --
// T-0086's `frob sys plan` is the future ticket-filing seam).
// T-0151: `may "eval"` REMOVED here. It was measured from vet's capability
// scanner matching bare `compile(` against this package's `re.compile(`
// calls (_FRONTMATTER_RE, _AD_ID_RE, _TODO_RE, etc -- all regex, zero real
// eval/exec/dynamic-import anywhere in src/frob/gates/**, confirmed by
// direct grep). The scanner's `compile(` needle now only counts a BARE
// builtin call (T-0151, src/frob/vet/_capability.py), so this package no
// longer observes "eval" and the declaration would otherwise be a stale,
// unfalsifiable claim -- exactly what SYS101 exists to catch.
// frob:doc docs/strata/roadmap.md#self-hosting-commitments-decision-d7
// frob:ticket T-0956
// frob:ticket T-1227
// frob:ticket T-1340
// frob:waive AFFECT001 reason="T-1113: mechanical interface= attr population (measured public-surface metadata for the new mandatory SYS104 check), not a behavioral/architectural change -- the cited affects()-closure doc does not describe this node's public surface and has nothing to update here."
node gates : trusted {
    clearance Internal;
    code "src/frob/gates/**";
    // T-0207: `_pii_structural.py` (the SEC110 detector) references
    // `os.environ`/`os.getenv` as the scan-pattern data it matches AGAINST
    // -- the capability scanner observes an `env` capability there. Declared
    // honestly-to-the-measurement (a sound may-analysis over-approximation:
    // the scanner cannot prove gates never reads env), matching how every
    // other node's `may` set is measured from `scan_directory_capabilities`.
    may "env";
    may "fs.write";
    may "fs.read";
    // T-0443: the DOC004 console/bash command-drift tier resolves the
    // `[[docblocks.commands]]` parser source by dotted path via
    // importlib.import_module (gates/_docblocks.py) -- a dynamic-import
    // (eval-family) capability the scanner rightly observes. The import
    // target comes from tracked frob.toml, not user input, and failures
    // fail open to the unbound warning path.
    may "eval";
    // T-0956/T-1146: same SYS203/tickets_ledger disposition as `cli`
    // above -- SYS203 now genuinely discharges live here too (the
    // `waive "SYS203:tickets_ledger" ...` clause this comment used to
    // justify is REMOVED; see `cli`'s full comment above for the
    // reasoning).
    access "tickets_ledger" mode write;
    // T-1158: SYS205 WRITE path-scoping now discharges cleanly via a
    // real owns= claim -- T-1164 fixed the blast-radius false positive
    // this declaration would otherwise have triggered (bare runs_as=None
    // treated as a compromised-user identity), and T-1146/T-1149 wired
    // module= into the live check_resource_contention call so SYS201
    // stays arbiter-aware for this owns= claim (tickets_ledger's shared
    // lock, verified: `frob sys audit` clean with no new SYS201/SYS205
    // findings). The `waive "SYS205:tickets_ledger" ...` clause this
    // comment used to justify is REMOVED.
    owns "tickets.md" "0644";
    attr interface=ALL_PROVIDERS;
    attr interface=BASELINE_REL;
    attr interface=CRITICAL_PROVIDERS;
    attr interface=CoverageData;
    attr interface=CoverageError;
    attr interface=DEFAULT_SWEEP_BUDGET_SECONDS;
    attr interface=DebtEntry;
    attr interface=Decision;
    attr interface=DecisionError;
    attr interface=DeprecatedBaselineEntry;
