// graph+lang: src/frob/graph/**, src/frob/lang/**, src/frob/arch/**. Owns
// parsing (tree-sitter walkers + the strata-core native module), the
// symbol graph snapshot, and per-language digest extraction that every
// other component reads.
// T-0158: `may "sql"` added -- graph/cache.py's sqlite cache writer matches
// the registry's python/sql DangerousOperation (string-formatted
// cursor.execute), a real (if benign, parameterization-owned) observed
// capability the new exhaustive registry now surfaces that the coarser
// old pattern table never patterned.
// frob:doc docs/strata/roadmap.md#self-hosting-commitments-decision-d7
// frob:waive AFFECT001 reason="T-1113: mechanical interface= attr population (measured public-surface metadata for the new mandatory SYS104 check), not a behavioral/architectural change -- the cited affects()-closure doc does not describe this node's public surface and has nothing to update here."
node graphlang : trusted {
    clearance Internal;
    code "src/frob/graph/**" "src/frob/lang/**" "src/frob/arch/**";
    may "eval";
    may "fs.write";
    may "fs.read";
    may "sql";
    // T-0845: graph_cache's fill/invalidation flows are `_infra.py::
    // _cache_node_and_fill_flow`/`_cache_invalidation_flow_for`-
    // synthesized edges. They now carry `_infra.py::_CACHE_LOCAL_ATTR`
    // (`"local"`) unconditionally -- an explicit local disposition for
    // every `cache` construct's in-process in-memory flows (chosen over
    // a per-flow `attr` grammar clause, which would need a strata-core
    // parser change outside this ticket's scope) -- so REL200 no longer
    // fires on them and the prior waivers are burned down.
    attr interface=AffectedSet;
    attr interface=ArchCategory;
    attr interface=ArchResult;
    attr interface=ArchSeverity;
    attr interface=ArchSuggestion;
    attr interface=BuildError;
    attr interface=BuildStats;
    attr interface=ByteRange;
    attr interface=COMMENT_TYPES;
    attr interface=CacheLocked;
    attr interface=CallGraph;
    attr interface=CtypesBoundaryCall;
    attr interface=DATA_CLUMP_MIN_GROUP_SIZE;
    attr interface=DATA_CLUMP_MIN_SITES;
    attr interface=DEEP_INHERITANCE_THRESHOLD;
    attr interface=DanglingEdge;
    attr interface=Digests;
    attr interface=DischargeResult;
    attr interface=DriftReport;
    attr interface=Edge;
    attr interface=EdgeKind;
    attr interface=FACETS;
    attr interface=FACET_ARCH;
    attr interface=FACET_CAPABILITY;
    attr interface=FACET_DOCBLOCK;
    attr interface=FACET_DUP;
    attr interface=FACET_GRAMMAR;
    attr interface=FAT_INTERFACE_MIN_IMPLEMENTERS;
    attr interface=FAT_INTERFACE_MIN_METHODS;
    attr interface=FAT_INTERFACE_STUB_FRACTION;
    attr interface=FacetState;
    attr interface=FacetStatus;
    attr interface=FunctionMayRaise;
    attr interface=FunctionSummary;
    attr interface=GENERATED_MARKER_RE;
    attr interface=GOD_MODULE_MIN_CLUSTERS;
    attr interface=GOD_MODULE_MIN_EXPORTS;
    attr interface=GraphError;
    attr interface=GraphSnapshot;
    attr interface=INSTALL_HINT;
    attr interface=KNOWN_GAP_TRACKING_TICKETS;
    attr interface=KotlinAdapter;
    attr interface=LCOM4_MIN_FIELD_USING_METHODS;
    attr interface=LCOM4_MIN_METHODS;
    attr interface=LangError;
    attr interface=Language;
    attr interface=LanguageAdapter;
    attr interface=LanguageSupport;
    attr interface=LayeringConfig;
    attr interface=LockEntry;
    attr interface=LockError;
    attr interface=LockFile;
    attr interface=MIXED_CONCERN_MIN_DECISION_POINTS;
    attr interface=MalformedDirective;
    attr interface=NARROW_CLIENT_MAX_USED_FRACTION;
    attr interface=NARROW_CLIENT_MIN_INTERFACE_METHODS;
