        is_lease_ttl_expired, is_valid_ticket_ref, iter_raw_ledger_frontmatter, land, land_plan, large_glob_warnings,
        lease_age_seconds, leased_by, leases_dir, ledger_digest, ledger_lock, ledger_path,
