        QueueEntry, QueueError, ReconcileReport, RenumberReport, ReviewEntry, ReviewVerdict,
        ScopeChangeEntry, ScopeChangeOp, SprintReport, SprintTransition, SprintVelocityReport, Stride,
        Ticket, TicketError, TicketFlowReport, TicketFlowRow, TicketKind, TicketQueue,
        TicketSpec, TicketState, TicketTier, _archived_ids, _commit_message, _deletion_owned,
        _validate_acceptance_bound, _validate_closeable, _validate_evidence_kind_consistency, add_acceptance, add_cmd_evidence, add_evidence,
        agent_env_exports, allocator_lock, amend_acceptance, archive, archive_path, archive_v2,
        atomic_write, attach, attachments_dir, base_ref_resolvable, board_view, brief_cluster,
        brief_ticket, check_ticket_mutation_evidence, clipboard_has_image, clipboard_image, cluster_descendants, cluster_union_scope,
        commit_start_transition, commit_ticket_ledger_change, compose_brief, compose_cluster_brief, compose_done_report, compute_changed_lines,
