// payments_hardened.strata -- hardened (post-remedy) payments litmus.
//
// The surface-syntax twin of `_payments_model(hardened=True)` in
// tests/unit/strata/test_litmus_payments.py (docs/strata/roadmap.md, phase 1
// exit criterion T-0063). Applies every remedy the naive model's golden
// findings demand: endorse the Stripe response path (b_stripe_resp) and the
// webhook-queue-to-api path (b_webhook), mark `api` and `webhookq`
// idempotent, and read the refund decision straight off the ledger instead
// of the stale dashboard replica (f_refund_read: ledger -> refund). All
// four asserts must PROVE and build_facts diagnostics must be empty; these
// goldens are enforced in CI by tests/unit/strata/test_litmus_surface.py.

module payments

node browser : foreign { clearance Public; }
node stripe : authenticated { clearance Internal; }
node gateway : trusted { clearance Pii; }
node api : trusted { clearance Pii; attr idempotent; }
node ledger : trusted { clearance Secret; }
node replica : trusted { clearance Secret; }
node dashboard : trusted { clearance Internal; }
node refund : trusted { clearance Pii; }
node webhookq : trusted { clearance Internal; attr idempotent; }
node audit : trusted { clearance Secret; }

flow f_ingress : browser -> gateway { label Pii; }
flow f_gw_api : gateway -> api { label Pii; }
flow f_api_ledger : api -> ledger { label Pii; }
flow f_stripe_resp : stripe -> api { label Internal; }
flow f_repl : ledger -> replica { label Internal; age 5 min; }
flow f_dash : replica -> dashboard { label Internal; age 30 s; }
flow f_refund_read : ledger -> refund
flow f_webhook : stripe -> webhookq { label Internal; attr delivery=at_least_once; }
flow f_wq_api : webhookq -> api { label Internal; attr delivery=at_least_once; }
flow f_gw_audit : gateway -> audit { label Internal; }

boundary b_ingress endorse f_ingress : foreign -> authenticated when "jwt_verified"
boundary b_stripe_resp endorse f_stripe_resp : authenticated -> trusted when "schema_validated"
boundary b_webhook endorse f_wq_api : authenticated -> trusted when "webhook_signature_verified"

assert c_no_browser_ledger noflow browser -> ledger
assert c_no_stripe_ledger noflow stripe -> ledger
assert c_fresh_refund bound age refund <= 60 s
assert c_audit_path reach gateway -> audit
assume a_disk_encryption noflow foreign -> ledger owner logan review "2026-10-01"
