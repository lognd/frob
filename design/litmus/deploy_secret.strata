// deploy_secret.strata -- secret/deploy litmus (T-0136 exit criterion).
//
// Surface-syntax twin of the T-0082 (std.secrets) and T-0083 (std.deploy)
// kernel constructs, exercised through the T-0136 surface grammar that
// finally makes both reachable from `.strata` source text
// (docs/strata/surface.md#std-secrets, #std-deploy). Stresses:
//   - a `secret` construct desugaring to the mandatory issue/revoke/reads
//     flow triad plus the auto-generated readers() SetEquality claim.
//   - an `on deploy { ... }` node contract naming a real endorsement-chain
//     boundary and a staged canary schedule, reaching
//     `evaluate_deploy_contracts` (T-0083's landed evaluator) end to end.
//   - a credential AGE bound (docs/strata/surface.md#std-secrets: "a
//     caller wanting a bound on the credential's own age asserts an
//     ordinary AGE bound claim") over the secret's issue flow.
//
// `worker` (the deploying node) is deliberately NOT the secret's audience
// member (`api` is): `on deploy`'s rollback scenario is a total-loss
// `RemoveNode` rewrite on the deploying node, and removing a node that is
// also a claim's declared readers-set member would collapse the
// auto-generated `db_creds__readers` SetEquality claim into an evaluator
// error rather than a clean PROVED/REFUTED verdict -- keeping the two
// concerns on separate nodes is the realistic shape anyway (the service
// being deployed is rarely the same node as the credential's fixed
// audience list).
//
// tested end to end (parse -> elaborate -> evaluate_claims /
// evaluate_deploy_contracts) by tests/unit/strata/test_litmus_deploy_secret.py;
// these are permanent CI goldens.

module deploy_secret

// The issuing authority: a trusted secrets-management service.
node vault : trusted { clearance Secret; }

// The sole authorized reader of the credential this module issues.
node api : trusted { clearance Internal; }

// A review boundary the worker's build artifact must cross before deploy
// is permitted -- the endorsement chain `on deploy` validates against.
boundary review_gate endorse f_artifact : Public -> Internal

node builder : authenticated { clearance Public; }

// The deploying node: a two-stage canary (authenticated bake, then full
// trusted promotion), gated on the review_gate endorsement, with a
// 10-minute rollback budget.
node worker : trusted {
    clearance Internal;
    on deploy {
        canary { authenticated for 10 min, trusted for 30 min };
        endorsed_by review_gate;
        rollback within 10 min;
    }
}

flow f_artifact : builder -> worker { label Public; }

// The database credential: issued by vault, readable only by api, a
// 24h rotation lifetime, and a mandatory 5-minute revocation SLA.
secret db_creds {
    issued_by vault;
    audience { api };
    lifetime 24 h;
    revoke 5 min;
}

// Credential freshness: the issued db_creds secret must rotate at least as
// often as its declared 24h lifetime, PROVED.
assert c_secret_age_bound bound age db_creds <= 24 h
