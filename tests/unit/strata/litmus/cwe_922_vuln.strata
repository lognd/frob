// cwe_922_vuln.strata -- T-0145 per-CWE litmus: CWE-922 (Insecure Storage
// of Sensitive Information) fires undischarged from `app`'s `may
// "client_storage"` capability (docs/strata/threat.md#the-catalog-
// stdcwe). No claim discharges it here.
//
// tested end to end (parse -> elaborate -> check_discharge_completeness)
// by tests/unit/strata/test_litmus_cwe.py.

module cwe_922_vuln

node user : foreign { clearance Public; }
node app : trusted {
    clearance Internal;
    may "client_storage";
}

flow f_save : user -> app { label Public; }

// frob:waive REF002 reason="litmus fixture read by exactly one dedicated test module by design (T-0145/T-0255/T-0256/T-0262/T-0172/T-0154/T-0155/T-0223/T-0226 litmus suites); a second consumer would not be genuine"
