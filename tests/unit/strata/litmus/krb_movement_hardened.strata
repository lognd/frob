// krb_movement_hardened.strata -- T-0263 litmus: the hardened twin of
// krb_movement_vuln.strata -- constrained (never unconstrained)
// delegation targeting a same-trust backend, a two-way trust between
// two SAME-trust realms (no escalation), and the one unavoidable
// roastable-SPN honest gap discharged via an explicit gMSA/machine-
// account waiver -- KRB001-004 must all discharge.
//
// tested end to end by tests/unit/strata/test_litmus_krb_movement.py.

module krb_movement_hardened

node a_kdc : trusted {
    clearance Internal;
    realm "A.EXAMPLE";
    kdc;
    trusts b_kdc direction "two-way" transitive;
}

node b_kdc : trusted {
    clearance Internal;
    realm "B.EXAMPLE";
    kdc;
}

node app : trusted {
    clearance Internal;
    realm "A.EXAMPLE";
    runs_as "app-svc";
    spn "HTTP/app.corp.example@A.EXAMPLE";
    delegation constrained target "HTTP/backend.corp.example@A.EXAMPLE";
    waive "KRB002:HTTP/app.corp.example@A.EXAMPLE" reason "gMSA-backed service account, rotated automatically by AD -- not roastable";
}

node backend : trusted {
    clearance Internal;
    realm "A.EXAMPLE";
    runs_as "backend-svc";
    spn "HTTP/backend.corp.example@A.EXAMPLE";
    waive "KRB002:HTTP/backend.corp.example@A.EXAMPLE" reason "gMSA-backed service account, rotated automatically by AD -- not roastable";
}

// frob:waive REF002 reason="litmus fixture read by exactly one dedicated test module by design (T-0145/T-0255/T-0256/T-0262/T-0172/T-0154/T-0155/T-0223/T-0226/T-0263 litmus suites); a second consumer would not be genuine"
