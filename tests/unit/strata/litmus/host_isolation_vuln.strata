// host_isolation_vuln.strata -- T-0256 litmus: two service users sharing
// a writable filesystem path, a listening port, AND (T-0272) an OS
// group, with no declared Flow bridging them -- the shared-user VULN
// shape HOST001 must fire on (shared-writable-path, cross-user-socket,
// shared-group) and HOST002 must fire on (sudoers, now derived from a
// declared grant rather than an always-unprovable honest gap).
//
// tested end to end by tests/unit/strata/test_litmus_host_isolation.py.

module host_isolation_vuln

node api : trusted {
    clearance Internal;
    runs_as "svc-a";
    unit;
    owns "/var/lib/shared" "0664";
    listens 9000;
    group "ops";
    sudoers "ALL=(root) NOPASSWD: /bin/true";
}

node worker : trusted {
    clearance Internal;
    runs_as "svc-b";
    unit;
    owns "/var/lib/shared" "0664";
    listens 9000;
    group "ops";
}

// frob:waive REF002 reason="litmus fixture read by exactly one dedicated test module by design (T-0145/T-0255/T-0256/T-0262/T-0172/T-0154/T-0155/T-0223/T-0226 litmus suites); a second consumer would not be genuine"
