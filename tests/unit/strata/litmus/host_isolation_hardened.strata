// host_isolation_hardened.strata -- T-0256 litmus: two service users
// with fully disjoint owned paths, ports, and (T-0272) OS groups, and no
// declared sudoers grant at all -- the isolated hardened shape HOST001/
// HOST002 must fully discharge with NO waivers needed (shared-group and
// sudoers are now structurally provable false, not an always-fire
// honest gap that needed an explicit `waive`).
//
// tested end to end by tests/unit/strata/test_litmus_host_isolation.py.

module host_isolation_hardened

node api : trusted {
    clearance Internal;
    runs_as "svc-a";
    unit;
    owns "/etc/api" "0640";
    listens 8080;
    group "api-grp";
}

node worker : trusted {
    clearance Internal;
    runs_as "svc-b";
    unit;
    owns "/etc/worker" "0640";
    listens 8081;
    group "worker-grp";
}
