// contention_pipe_clean.strata -- T-0699 SYS202 litmus: the clean twin of
// contention_pipe_vuln.strata -- two distinct nodes each bind their OWN
// pipe name. SYS202 must not fire.
//
// tested end to end by tests/unit/strata/test_contention.py.

module contention_pipe_clean

node svc_a : trusted {
    clearance Internal;
    platform "windows";
    pipe "\\.\pipe\svc-a";
}

node svc_b : trusted {
    clearance Internal;
    platform "windows";
    pipe "\\.\pipe\svc-b";
}

// frob:waive REF002 reason="litmus fixture read by exactly one dedicated test module by design (T-0145/T-0255/T-0261/T-0699 litmus suites); a second consumer would not be genuine"
