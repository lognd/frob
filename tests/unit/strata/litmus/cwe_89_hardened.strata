// cwe_89_hardened.strata -- the hardened twin of cwe_89_vuln.strata
// (T-0145). SAME firing precondition (`db`'s `may "sql"`), discharged as
// an ASSUMED NoFlow claim named `weakness:CWE-89:db`
// (`_threat.py::_discharge_claim_id`), owned and reviewed.
//
// T-0345: `db`'s `may "sql"` ALSO fires CWE-639 (2025-list-new
// `CWE_TOP_25_CATALOG` entry, SAME `sql` capability join -- the identical
// two-obligation-one-capability shape design/litmus/audit_vuln.strata's
// docstring already documents for CWE-89/CWE-639) -- discharged here too
// so this fixture stays reusable as CWE-639's own hardened twin
// (test_litmus_cwe.py's `_HARDENED_FIXTURES["CWE-639"]`).
//
// tested end to end (parse -> elaborate -> check_discharge_completeness)
// by tests/unit/strata/test_litmus_cwe.py.

module cwe_89_hardened

node client : foreign { clearance Public; }
node db : trusted {
    clearance Internal;
    may "sql";
}

flow f_query : client -> db { label Public; }

assume "weakness:CWE-89:db" noflow client -> db owner logan review "2026-10-01"
assume "weakness:CWE-639:db" noflow client -> db owner logan review "2026-10-01"
