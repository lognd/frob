// grmb design corpus. Hand-written against docs/design/grmb-spec.md (cycle 1
// grammar); NOT machine-checked (the P1 parser predates cycle 1). Findings below
// are what the rules of that file predict, to be confirmed by P0/P1.
// Stress 3: include chain four deep with fails with and an unknown arm
//
// EXPECTED FINDINGS
//   Types propagate through all four levels: E(top) lists every undeclared leaf variant
//   MDL023 on the level that neither handles nor declares the leaf variant
//   MDL032 if an unknown arm is the only arm at any level
// NOT EXPRESSIBLE (open questions: docs/design/grmb-spec.md 19)

scenario l4 fails with { e4 } { a.step4 -!> end ok; }
scenario l3 fails with { e4, e3 } { include l4 -!> end ok; }
scenario l2 fails with { e4, e3, e2 } { include l3 -!> end ok; }
scenario l1 { include l2 => { unknown => end err(e4); } }
