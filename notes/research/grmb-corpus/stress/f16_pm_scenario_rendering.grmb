//   prose-to-grmb authoring (GAPS.md G6)

scenario checkout realizes customer.place_order {
  customer.submits_cart -> customer.pays => {
    ok -> system.confirms_order -> end ok;
    declined -> retry customer.pays max 3 else end err(declined);
    timeout -> end err(timeout);
  }
}
