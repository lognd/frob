// grmb design corpus. Hand-written against docs/design/grmb-spec.md (cycle 1
// grammar); NOT machine-checked (the P1 parser predates cycle 1). Findings below
// are what the rules of that file predict, to be confirmed by P0/P1.
// Web shop: guest and account checkout, payment gateway outcomes
//
// EXPECTED FINDINGS (as written; complete for MDL, FLOW, CLAIM, PLAN, SYS015-016,
// AMB; code-dependent rules (PLAN030-034, PLAN041-042, SYS001-012) assume the
// named code matches; each milestone checks its families, grmb-spec 18.3)
//   PLAN001 customer.browse, customer.track_order (leaves no scenario covers)
//   PLAN003 (customer.submits_cart, checkout), (system.confirms_order, checkout)
//   PLAN005 goal leaves browse, guest, account, track_order; impl customer.pays
//   PLAN006 one per pair: customer.pays.ok, customer.pays.declined (arm and
//     the map entry PaymentDeclined, 402), customer.pays.timeout (arm and
//     the map entry TimeoutError)
//   PLAN016 declined => retry max 3 (customer.pays is not idempotent)
//   PLAN004 absent on impl customer.pays (its waypoints bind)
//   SYS015 Unresolved on both step pairs (no node is declared)
//   AMB008 web_app policy; AMB001 absent
// IF EDITED
//   add fraud_hold to customer.pays: MDL022 on checkout
// NOT EXPRESSIBLE (open questions: docs/design/grmb-spec.md 19)
//   guest/account is modelled as goal variants (path), see stress f08

grimble = "2";
module shop;
/// Web shop
system web_app { ambient restart max 3 within 60 s else escalate; }
actor customer : human;
actor gateway : external;
goal customer { browse; place_order requires browse; track_order requires place_order; }
goal customer.place_order { guest; account; }
step customer.submits_cart;
step customer.pays : { ok, declined, timeout };
step system.confirms_order;
scenario checkout realizes customer.place_order.guest, customer.place_order.account {
  customer.submits_cart -> customer.pays => {
    ok => system.confirms_order -> end ok;
    declined => retry max 3;
    timeout => end err(timeout);
  }
  verified_by "tests/e2e/checkout.spec.ts";
}
impl customer.pays for checkout {
  chain {
    ui pay_button = "src/Pay.tsx::PayButton";
    route pay_route = "POST /orders/{id}/pay";
    call charge = "payments/client.py::charge" {
      PaymentDeclined, 402 => declined;
      TimeoutError => timeout;
    }
  }
}
