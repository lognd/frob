// grmb design corpus. Hand-written against docs/design/grmb-spec.md (cycle 1
// grammar); NOT machine-checked (the P1 parser predates cycle 1). Findings below
// are what the rules of that file predict, to be confirmed by P0/P1.
// Distributed saga: order, payment, inventory with compensation
//
// EXPECTED FINDINGS (as written; complete for MDL, FLOW, CLAIM, PLAN, SYS015-016,
// AMB; code-dependent rules (PLAN011, PLAN030-034, PLAN041-042, SYS001-012) assume the
// named code matches; each milestone checks its families, grmb-spec 18.3)
//   PLAN003 every step use (buyer.places, system.reserve, system.charge,
//     system.release_stock)
//   PLAN005 goal leaf buyer.place
//   PLAN006 arms ok (reserve), out_of_stock, ok (charge), declined
//   PLAN014 system.refund (a step used nowhere)
//   PLAN016 the ambient retry policy (system.charge and system.release_stock
//     are not idempotent; actor steps are never repeated)
//   SYS016 Unresolved on f1 and f2 (no step use has a known node)
//   SYS015 Unresolved on every pair (no impls)
//   AMB008 orders policy
// IF EDITED
//   a compensation arm ending `end ok` with no effect: PLAN012
// NOT EXPRESSIBLE (open questions: docs/design/grmb-spec.md 19)
//   compensation ordering as a stack (compensations are ordinary arms)
//   long-running saga state and timeouts across days

grimble = "2";
module saga;
system orders { ambient retry max 3 else escalate; }
node order_svc : trusted; node pay_svc : trusted; node stock_svc : trusted;
flow f1 : order_svc -> pay_svc { label Secret; }
flow f2 : order_svc -> stock_svc { label Internal; }
actor buyer : human;
goal buyer { place; }
step buyer.places;
step system.reserve : { ok, out_of_stock } idempotent;
step system.charge : { ok, declined };
step system.release_stock;
step system.refund;
scenario place_order realizes buyer.place {
  buyer.places -> system.reserve => {
    ok => system.charge => {
      ok => end ok;
      declined => system.release_stock -> end err(declined);
    }
    out_of_stock => end err(out_of_stock);
  }
  verified_by "tests/saga/place.py";
}
