// grmb design corpus. Hand-written against docs/design/grmb-spec.md (cycle 1
// grammar); NOT machine-checked (the P1 parser predates cycle 1). Findings below
// are what the rules of that file predict, to be confirmed by P0/P1.
// Mobile offline sync: queue, retry on reconnect, conflict
//
// EXPECTED FINDINGS (as written; complete for MDL, FLOW, CLAIM, PLAN, SYS015-016,
// AMB; code-dependent rules (PLAN011, PLAN030-034, PLAN041-042, SYS001-012) assume the
// named code matches; each milestone checks its families, grmb-spec 18.3)
//   PLAN003 every step use (user.edits, system.uploads, system.resolves_conflict)
//   PLAN005 goal leaf user.edit_offline
//   PLAN006 arms ok, offline, conflict
//   SYS015 Unresolved on every pair (no impls)
//   AMB008 app policy; PLAN016 absent (uploads is idempotent)
// IF EDITED
//   remove `idempotent` from uploads: PLAN016 on offline => retry max 5
// NOT EXPRESSIBLE (open questions: docs/design/grmb-spec.md 19)
//   connectivity as a state (online/offline) across scenarios
//   merge of conflicting edits (data-level, not flow-level)

grimble = "2";
module notes_app;
system app { ambient restart max 3 within 30 s else escalate; }
actor user : human;
goal user { edit_offline; }
step user.edits;
step system.uploads : { ok, offline, conflict } idempotent;
step system.resolves_conflict;
scenario sync realizes user.edit_offline {
  user.edits -> system.uploads => {
    ok => end ok;
    offline => retry max 5;
    conflict => system.resolves_conflict -> end ok;
  }
  verified_by "tests/sync/sync_test.dart";
}
