// grmb design corpus. Hand-written against docs/design/grmb-spec.md (cycle 1
// grammar); NOT machine-checked (the P1 parser predates cycle 1). Findings below
// are what the rules of that file predict, to be confirmed by P0/P1.
// CLI developer tool (frob dogfood): check --ticket
//
// EXPECTED FINDINGS (as written; complete for MDL, FLOW, CLAIM, PLAN, SYS015-016,
// AMB; code-dependent rules (PLAN030-034, PLAN041-042, SYS001-012) assume the
// named code matches; checked one way, see grmb-spec 18.3 P1)
//   PLAN003 (system.loads_ticket, check_ticket), (system.runs_gates, check_ticket)
//   PLAN005 goal leaf dev.gate_ticket; impl dev.runs_check
//   PLAN006 arms ok, not_found (loads_ticket) and ok, scope_violation, drift
//   SYS015 Unresolved on every pair (no node is declared)
//   AMB008 frob policy
// IF EDITED
//   make runs_gates open and add an unknown arm, then a new variant lands
//     only there: PLAN017
// NOT EXPRESSIBLE (open questions: docs/design/grmb-spec.md 19)
//   exit codes as a numeric open set (modelled as variants, no payload type)

grimble = "2";
module frob_cli;
/// frob check
system frob { ambient terminate; }
actor dev : human;
goal dev { gate_ticket; }
step dev.runs_check;
step system.loads_ticket : { ok, not_found };
step system.runs_gates : { ok, scope_violation, drift };
scenario check_ticket realizes dev.gate_ticket {
  dev.runs_check -> system.loads_ticket => {
    ok => system.runs_gates => {
      ok => end ok;
      scope_violation => end err(scope_violation);
      drift => end err(drift);
    }
    not_found => end err(not_found);
  }
  verified_by "tests/cli/check_ticket.rs";
}
impl dev.runs_check for check_ticket { cli = "crates/frob-cli/src/check.rs::run"; }
