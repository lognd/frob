[build-system]
requires = ["scikit-build-core>=0.9", "pybind11>=2.13"]
build-backend = "scikit_build_core.build"

[project]
name = "{{ project.name }}"
version = "0.1.0"
description = ""
requires-python = ">=3.10"
license = { text = "MIT" }
authors = [{ name = "", email = "" }]

[tool.scikit-build]
cmake.build-type = "Release"
wheel.expand-macos-universal-wheel = false

[dependency-groups]
dev = [
    "pytest>=8",
    "ruff>=0.8",
]
