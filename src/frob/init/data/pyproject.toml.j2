[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project.name }}"
version = "0.1.0"
description = ""
readme = "README.md"
requires-python = ">=3.10"
license = { text = "MIT" }

dependencies = []

[tool.setuptools]
packages = { find = { where = ["src"] } }

[tool.setuptools.package-data]
{{ project.name }} = ["py.typed"]

[tool.ruff]
line-length = 88

[tool.ruff.lint]
select = ["E", "F", "W", "I"]

[tool.black]
line-length = 88

[tool.isort]
profile = "black"
