[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project.name }}"
version = "0.1.0"
description = ""
readme = "README.md"
requires-python = ">=3.11"
license = { text = "MIT" }

dependencies = [
    "typani>=0.0.3",
    "pydantic>=2.12.0",
{%- if project.type == "python-tool" %}
    "python-dotenv>=1.0",
{%- endif %}
]
{% if project.type == "python-tool" %}
[project.scripts]
{{ project.name }} = "{{ project.import_name }}.__main__:main"
{% endif %}
[dependency-groups]
dev = [
    "pytest>=8",
    "pytest-cov>=5",
    "ruff>=0.8",
    "ty>=0.0.1a8",
]

[tool.setuptools]
packages = { find = { where = ["src"] } }

[tool.setuptools.package-data]
{{ project.import_name }} = ["py.typed", "logging/config.toml"]

# frob:ticket T-4406
# pythonpath explicitly includes "src" (not just ".") because relying
# solely on the editable install to make the src-layout package
# importable is not portable: on win32, an xdist worker spawned via
# `multiprocessing.spawn` re-imports site configuration from scratch
# rather than inheriting the parent process's already-patched sys.path,
# and MEASURED on the win32 mirror (T-4406) this can leave a freshly
# scaffolded project's own package unimportable in that worker
# (`ModuleNotFoundError: No module named '<project>'`) even though `uv
# sync`'s editable install reported success moments earlier. Adding
# "src" here makes pytest itself put the source directory on sys.path
# for every worker, independent of whether the editable-install shim
# survived a spawned worker -- a portable addition (not a
# platform branch): it is a no-op on POSIX, where the editable install
# already makes the package importable.
[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
pythonpath = ["src", "."]

[tool.ruff]
line-length = 88
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "W", "I"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["E501"]

[tool.ruff.format]
quote-style = "double"

[tool.frob]
# T-4184: automatic per-land PEP 440 dev-version bump, on by default --
# every land writes a X.Y.(Z+1).devN version with no manual step, so two
# builds never silently report the same version for different code. Set
# to false before cutting a real release (a dev suffix has no place in a
# published final version), then back to true afterward. The FIRST time
# a land's computed bump would cross into a new major version series
# with this still on, it refuses until you add
# dev_version_major_ack = <major> below to explicitly keep it on across
# that boundary -- a major version bump is a real compatibility event,
# not something to sail through silently.
dev_version_bump = true
