name: CI

on:
  push:
    branches: ["main", "master"]
  pull_request:
    branches: ["main", "master"]

concurrency:
  group: ci-${{ "{{" }} github.workflow {{ "}}" }}-${{ "{{" }} github.ref {{ "}}" }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: astral-sh/setup-uv@v4
        with:
          enable-cache: true
          cache-dependency-glob: "uv.lock"

      - name: install
        run: uv sync

      - name: lint
        run: uv run ruff check src/ tests/ && uv run ruff format --check src/ tests/

      - name: typecheck
        run: uv run ty check src/

      - name: test
        run: uv run pytest tests/ --cov=src --cov-report=term-missing

      # NOTE: frob is not yet on PyPI (pre-0.1.0). `uv tool install frob`
      # below installs whatever the latest published release is, which may
      # be older than the frob.toml/gates this project was scaffolded
      # against. A missing/broken frob install here means the frob check
      # gate genuinely could NOT run -- that must show up as a loud,
      # non-green CI status (a GitHub Actions ::error:: plus a failed
      # step), never as a quiet notice next to an otherwise-green build.
      # A skipped gate that only prints a notice is indistinguishable
      # from a passing one in a green build.
      - name: install frob
        run: uv tool install frob || true

      - name: frob check
        run: |
          if command -v frob >/dev/null 2>&1 && frob graph --help >/dev/null 2>&1; then
            frob check
          else
            echo "::error::frob check could not run -- frob is not installed or not working (install: uv tool install frob). This gate is UNMEASURED, not clean; fix the install rather than ignoring this failure."
            exit 1
          fi
