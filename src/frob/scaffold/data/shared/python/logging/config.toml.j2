version = 1
disable_existing_loggers = false

[filters.below_warning]
"()" = "{{ project.import_name }}.logging.filter.BelowLevelFilter"
below = "WARNING"

[formatters.stdout_fmt]
"()" = "{{ project.import_name }}.logging.formatter.SimpleFormatter"

[formatters.stderr_fmt]
"()" = "{{ project.import_name }}.logging.formatter.SimpleFormatter"
show_level = true

# T-5466: "()" custom-callable + stream_name kwarg (not class = "logging.StreamHandler"
# with stream = "ext://sys.stdout") -- the ext:// resolver only runs once,
# at dictConfig-load time, which breaks pytest capsys (a new stdout object
# per test) in this project's own generated test suite. LiveStreamHandler
# reads sys.stdout/sys.stderr fresh on every emit instead.
[handlers.stdout]
"()" = "{{ project.import_name }}.logging.stream_handler.LiveStreamHandler"
stream_name = "stdout"
formatter = "stdout_fmt"
level = "DEBUG"
filters = ["below_warning"]

[handlers.stderr]
"()" = "{{ project.import_name }}.logging.stream_handler.LiveStreamHandler"
stream_name = "stderr"
formatter = "stderr_fmt"
level = "WARNING"

# T-4764: this project's OWN top-level logger, named after its package
# (never the literal Python root) -- so two scaffolded projects loaded
# in the same process never share a logger identity. propagate = false
# keeps records from also reaching the real root logger's handlers.
[loggers."{{ project.import_name }}"]
level = "DEBUG"
handlers = ["stdout", "stderr"]
propagate = false
