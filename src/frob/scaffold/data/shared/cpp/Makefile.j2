.PHONY: all configure build test install release clean check format lint

PROJECT   := {{ project.name }}
BUILD_DIR := build
REL_DIR   := build-release
TYPE      := Debug
FLAGS     :=

all: build test

# T-4760: configure/build/release/install are genuine cmake bootstrap
# and stay hand-written. format/lint/check/test below are generated
# one-line calls to `frob run <name>` (see the managed block) -- the
# actual command lives once, in this project's frob.toml [commands]
# table. `frob scaffold apply` regenerates that block; do not hand-edit
# within its markers. The old `publish` target (a 15-line shell script
# re-implementing the version-bump/commit-message rule) is removed: a
# release verb belongs in `frob release`, not a second home in make.

# ---------- configure & build ----------

configure:
	cmake -B $(BUILD_DIR) \
	      -DCMAKE_BUILD_TYPE=$(TYPE) \
	      -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
	      $(FLAGS)

build: configure
	cmake --build $(BUILD_DIR) --parallel

release:
	cmake -B $(REL_DIR) -DCMAKE_BUILD_TYPE=Release $(FLAGS)
	cmake --build $(REL_DIR) --parallel

# ---------- install ----------

install: release
	cmake --install $(REL_DIR)

# frob:managed-block BEGIN makefile-wrapper-targets (frob scaffold apply -- do not hand-edit within markers)
# Every target/branch below is a one-line call to `frob run <name>` -- the named entry lives once, in this project's frob.toml [commands] table (or a frob-native default when undeclared). Do not hand-edit within this block: `frob scaffold apply` regenerates it from [commands], and the wrapper-drift gate (T-4760) reports a target that expands more than one command inline or names an entry [commands] no longer declares.
check:
	frob run check
format:
	frob run format
lint:
	frob run lint
test:
	frob run test
# frob:managed-block END makefile-wrapper-targets

# ---------- clean ----------

clean:
	rm -rf $(BUILD_DIR) $(REL_DIR)
