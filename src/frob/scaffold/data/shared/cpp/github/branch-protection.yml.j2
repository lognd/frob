name: Branch Protection

# This workflow enforces that all tests pass before merging.
# To complete the setup, configure branch protection rules in GitHub:
#   Settings > Branches > Add rule for "main":
#     [x] Require status checks to pass before merging
#         Add: "Build and test / linux-x86_64" (and others you care about)
#     [x] Require branches to be up to date before merging
#     [x] Do not allow bypassing the above settings  <- prevents admin force-push

on:
  pull_request:
    branches: ["main", "master"]
  push:
    branches: ["main", "master"]

jobs:
  gate:
    name: All tests pass
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Configure
        run: cmake -B build -DCMAKE_BUILD_TYPE=Debug

      - name: Build
        run: cmake --build build --parallel

      - name: Test
        run: ctest --test-dir build --output-on-failure

      - name: Confirm gate passed
        run: echo "All tests passed -- merge is allowed."
