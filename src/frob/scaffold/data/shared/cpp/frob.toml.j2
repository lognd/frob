check_base = "main"

# T-1576: brand-new scaffolded repos start on the rapid profile --
# see docs/modules/tickets.md#development-profiles-frobtoml-profile-t-1575.
# The one-way auto-ratchet upgrades this to standard automatically once
# the repo grows past frob.tickets._profile's thresholds; downgrading
# back to rapid after that is an explicit `frob profile downgrade` call.
[profile]
profile = "rapid"

[gates.severity]

[testing]
min_unit_cases = 1
min_integration = 1
unit_branch_cov = 50
module_line_cov = 50
system_line_cov = 50

[[test.runner]]
language = "cpp"
command = ["ctest", "--test-dir", "build", "--output-on-failure", "-R", "{ids}"]
all_command = ["ctest", "--test-dir", "build", "--output-on-failure"]
cwd = "."
