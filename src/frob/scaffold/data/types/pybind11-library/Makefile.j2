BUILD_DIR := build
NAME      := {{ project.name }}

.PHONY: all build install develop test lint clean

all: develop

develop:
	pip install -e ".[dev]" --no-build-isolation

build:
	pip build --no-build-isolation

test:
	pytest tests/ -q

lint:
	ruff check src/ tests/

clean:
	rm -rf $(BUILD_DIR) dist/ *.egg-info _skbuild
