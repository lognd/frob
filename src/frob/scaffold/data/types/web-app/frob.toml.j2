# Project: repo-wide settings frob itself needs (which branch `frob
# check --base` diffs against). Edit if your default branch is not main.
check_base = "main"

# Profile: how strict the gates are. New projects start on "rapid" (a
# lighter bar while the codebase is small); frob auto-upgrades this to
# "standard" once the project grows past a size threshold. Downgrade by
# hand with `frob profile downgrade` if you ever need to.
[profile]
profile = "rapid"

# Testing: the coverage/case-count floors `frob check`'s TEST/COV gates
# enforce. Raise these as the real test suite grows -- they start low
# because a brand-new project has one smoke test per symbol, not three.
[testing]
min_unit_cases = 1
min_integration = 1
unit_branch_cov = 50
module_line_cov = 50
system_line_cov = 50

[[test.runner]]
language = "typescript"
command = ["npx", "vitest", "run", "{ids}"]
all_command = ["npx", "vitest", "run"]
cwd = "."

# Gates: per-rule severity overrides. Empty by default -- severities
# come from the profile above; add a line here only to override one
# specific rule for this project.
[gates.severity]

# Tickets: the milestone new tickets default onto until you set your
# project's own.
[tickets]
default_milestone = "0.1.0"

# Refs: files read by something outside this project's own tracked-file
# graph (vite/tsc/eslint/CI, a human, or the browser by index.html
# convention) rather than imported or linked from other tracked source --
# exempted from the anti-orphan gate here so a fresh, untouched checkout
# is not flagged for having them. Kept explicit until a landed refs-gate
# update recognizes ordinary scaffold conventions by default without a
# declaration (tracked separately).
[[refs.entrypoint]]
path = "index.html"
reason = "the browser's own entry point by Vite convention, not imported from tracked source"

[[refs.entrypoint]]
path = "vite.config.ts"
reason = "read by the Vite CLI outside this repo's own tracked-file graph, not imported from source"

[[refs.entrypoint]]
path = "eslint.config.js"
reason = "read by the ESLint CLI outside this repo's own tracked-file graph, not imported from source"

[[refs.entrypoint]]
path = ".prettierrc.json"
reason = "read by the Prettier CLI outside this repo's own tracked-file graph, not imported from source"

[[refs.entrypoint]]
path = "src/vite-env.d.ts"
reason = "ambient type declarations loaded by tsc by convention, never imported by name from source"

[[refs.entrypoint]]
path = "tests/setup.ts"
reason = "vitest's own fixture-setup entry point, loaded by path convention, never imported by tracked source"

[[refs.entrypoint]]
path = ".github/workflows/*.yml"
reason = "read by GitHub Actions outside this repo's own tracked-file graph, never imported/referenced from source"

[[refs.entrypoint]]
path = "Makefile"
reason = "read by `make` outside this repo's own tracked-file graph, not referenced from source"

[[refs.entrypoint]]
path = "invariants/.gitkeep"
reason = "placeholder that keeps the empty invariants/ directory tracked by git; never referenced by name from source"

[[refs.entrypoint]]
path = "README.md"
reason = "read by humans/GitHub, not referenced from tracked source"

[[refs.entrypoint]]
path = "docs/index.md"
reason = "the project's own doc entry point, read by humans, not referenced from tracked source"
