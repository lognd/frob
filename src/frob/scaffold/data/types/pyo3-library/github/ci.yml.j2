name: CI

on:
  push:
    branches: ["main", "master"]
  pull_request:
    branches: ["main", "master"]

concurrency:
  group: ci-${{ "{{" }} github.workflow {{ "}}" }}-${{ "{{" }} github.ref {{ "}}" }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy

      - uses: Swatinem/rust-cache@v2

      - uses: astral-sh/setup-uv@v4
        with:
          enable-cache: true
          cache-dependency-glob: "uv.lock"

      - name: install
        run: uv sync

      - name: build extension
        run: uv run maturin develop --uv

      - name: rust lint
        run: cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings

      - name: python lint
        run: uv run ruff check python/ tests/ && uv run ruff format --check python/ tests/

      - name: typecheck
        run: uv run ty check python/{{ project.name }}

      - name: test
        run: cargo test --workspace && uv run pytest tests/ --cov={{ project.name }} --cov-report=term-missing

      # See python-tool's ci.yml.j2 for why frob is installed with
      # `|| true`: it is pre-0.1.0 on PyPI. A missing/broken install
      # still means the frob check gate could NOT run -- that must be a
      # loud, non-green CI status, never a quiet notice on an otherwise
      # green build.
      - name: install frob
        run: uv tool install frob || true

      - name: frob check
        run: |
          if command -v frob >/dev/null 2>&1 && frob graph --help >/dev/null 2>&1; then
            frob check
          else
            echo "::error::frob check could not run -- frob is not installed or not working (install: uv tool install frob). This gate is UNMEASURED, not clean; fix the install rather than ignoring this failure."
            exit 1
          fi
