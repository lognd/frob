[build-system]
requires = ["maturin>=1.7,<2.0"]
build-backend = "maturin"

[project]
name = "{{ project.name }}"
version = "0.1.0"
description = ""
requires-python = ">=3.10"
license = { text = "MIT" }
authors = [{ name = "", email = "" }]

[tool.maturin]
features = ["pyo3/extension-module"]
module-name = "{{ project.name }}._{{ project.name }}"
python-source = "python"

[dependency-groups]
dev = [
    "pytest>=8",
    "maturin>=1.7",
    "ruff>=0.8",
]
