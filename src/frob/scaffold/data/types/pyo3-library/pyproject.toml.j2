[build-system]
requires = ["maturin>=1.7,<2.0"]
build-backend = "maturin"

[project]
name = "{{ project.name }}"
version = "0.1.0"
description = ""
requires-python = ">=3.11"
license = { text = "MIT" }

[dependency-groups]
dev = [
    "pytest>=8",
    "pytest-cov>=5",
    "maturin>=1.7,<2.0",
    "ruff>=0.8",
    "ty>=0.0.1a8",
]

[tool.maturin]
manifest-path = "crates/Cargo.toml"
python-source = "python"
module-name = "{{ project.name }}._core"
features = ["pyo3/extension-module"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"

[tool.ruff]
line-length = 88
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "W", "I"]
