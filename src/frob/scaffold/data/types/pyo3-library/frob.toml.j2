check_base = "main"

# T-1576: brand-new scaffolded repos start on the rapid profile --
# see docs/modules/tickets.md#development-profiles-frobtoml-profile-t-1575.
# The one-way auto-ratchet upgrades this to standard automatically once
# the repo grows past frob.tickets._profile's thresholds; downgrading
# back to rapid after that is an explicit `frob profile downgrade` call.
[profile]
profile = "rapid"

# T-3931: a fresh repo has no way to know it must set this until the
# first `frob check` fires MILE003 on its own first ticket -- declare
# a sane starting point (matching the version above) day one instead.
[tickets]
default_milestone = "0.1.0"

[gates.severity]

# Sized for a fresh, minimal scaffold on day one -- raise as the real
# test suite grows.
[testing]
min_unit_cases = 1
min_integration = 1
unit_branch_cov = 50
module_line_cov = 50
system_line_cov = 50

[[test.runner]]
language = "python"
command = ["uv", "run", "pytest", "-q", "{ids}"]
all_command = ["uv", "run", "pytest", "-q"]
cwd = "."

[[test.runner]]
language = "rust"
command = ["cargo", "test", "--workspace", "{ids}"]
all_command = ["cargo", "test", "--workspace"]
cwd = "."
