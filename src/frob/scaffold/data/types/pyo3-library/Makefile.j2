STAMP := .venv/.install-stamp

.PHONY: install develop format lint typecheck test coverage check clean build

$(STAMP): pyproject.toml Cargo.toml
	uv sync
	@touch $(STAMP)

install: $(STAMP)

develop: $(STAMP)
	uv run maturin develop --uv

format: $(STAMP)
	cargo fmt --all
	uv run ruff check python/ tests/ --fix
	uv run ruff format python/ tests/

lint: $(STAMP) develop
	cargo fmt --all --check
	cargo clippy --workspace --all-targets -- -D warnings
	uv run ruff check python/ tests/
	uv run ruff format --check python/ tests/

typecheck: $(STAMP) develop
	uv run ty check python/{{ project.name }}

test: $(STAMP) develop
	cargo test --workspace
	uv run pytest tests/

coverage: $(STAMP) develop
	uv run pytest tests/ --cov={{ project.name }} --cov-report=term-missing --cov-report=xml

# ---------- the single gate: frob check ----------
check: lint typecheck test
	frob check --stamp-coverage
	frob check

build:
	uv run maturin build --release

clean:
	cargo clean
	rm -rf dist/ target/wheels/ .pytest_cache/ .ruff_cache/ .coverage
