STAMP := .venv/.install-stamp

.PHONY: install develop clean build check format lint test

$(STAMP): pyproject.toml Cargo.toml
	uv sync
	@touch $(STAMP)

install: $(STAMP)

# T-4760: install/develop/build (above/below) are genuine bootstrap and
# stay hand-written -- everything else is a generated one-line call to
# `frob run <name>` (see the managed block); `frob scaffold apply`
# regenerates it from this project's frob.toml [commands] table -- do
# not hand-edit within its markers. The old `check` target ran
# `frob check --stamp-coverage` then `frob check` back-to-back, exactly
# the PRE001/SCOPE001 trap docs/commands/scaffold.md warns against; that
# sequence now lives once, in [commands], not duplicated here.

develop: $(STAMP)
	uv run maturin develop --uv

build: $(STAMP)
	uv run maturin build --release

# frob:managed-block BEGIN makefile-wrapper-targets (frob scaffold apply -- do not hand-edit within markers)
# Every target/branch below is a one-line call to `frob run <name>` -- the named entry lives once, in this project's frob.toml [commands] table (or a frob-native default when undeclared). Do not hand-edit within this block: `frob scaffold apply` regenerates it from [commands], and the wrapper-drift gate (T-4760) reports a target that expands more than one command inline or names an entry [commands] no longer declares.
check:
	frob run check
format:
	frob run format
lint:
	frob run lint
test:
	frob run test
# frob:managed-block END makefile-wrapper-targets

clean:
	cargo clean
	rm -rf dist/ target/wheels/ .pytest_cache/ .ruff_cache/ .coverage
