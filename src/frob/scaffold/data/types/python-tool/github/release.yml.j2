name: Release

# Publishes to PyPI via OIDC trusted publishing -- no API token stored in
# this repo. One-time setup: on pypi.org, go to the project's
# "Publishing" settings and add a trusted publisher with:
#   Owner: <your GitHub org/user>   Repo: {{ project.name }}
#   Workflow: release.yml           Environment: pypi
# (leave "Environment" blank if you don't use a GitHub environment gate).

on:
  push:
    tags: ["v*"]

jobs:
  publish:
    runs-on: ubuntu-latest
    environment: pypi
    permissions:
      id-token: write
    steps:
      - uses: actions/checkout@v4

      - uses: astral-sh/setup-uv@v4

      - name: build
        run: uv build

      - name: publish
        uses: pypa/gh-action-pypi-publish@release/v1
