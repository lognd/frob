"""
System tests: verify the package installs, imports, and wires together.
"""

import ast
import importlib
import subprocess
import sys
import tomllib
from pathlib import Path


def test_package_imports():
    """The top-level package must be importable with no errors."""
    importlib.import_module("{{ project.import_name }}")


def test_py_typed_marker_present():
    """The `py.typed` marker declared in `pyproject.toml`'s package-data
    must actually exist -- a declaration with no backing file is a
    silent zero-match (setuptools does not error on it) and ships this
    package untyped to every downstream type checker."""
    marker = Path(__file__).parent.parent.parent / "src" / "{{ project.import_name }}" / "py.typed"
    assert marker.is_file()


def test_cli_help():
    """The CLI entry point must exit 0 with --help."""
    # frob:tests src/{{ project.import_name }}/__main__.py kind="integration"
    r = subprocess.run(
        [sys.executable, "-m", "{{ project.import_name }}", "--help"],
        capture_output=True,
        text=True,
    )
    assert r.returncode == 0


def test_app_package_wires_end_to_end():
    """App + AppConfig construct and run together, exactly as __main__ uses them."""
    # frob:tests src/{{ project.import_name }}/app kind="integration"
    from {{ project.import_name }}.app import App, AppConfig

    App(AppConfig())()


def test_logging_package_wires_end_to_end():
    """The dictConfig-driven logger initializes and emits without raising."""
    # frob:tests src/{{ project.import_name }}/logging kind="integration"
    from {{ project.import_name }}.logging import get_logger

    get_logger(__name__).info("smoke test")


def test_typani_floor_is_the_recorded_release():
    """The pyproject typani floor must equal 0.2.3 -- the latest published
    release recorded in T-4763 -- so a future bump is a deliberate edit,
    not silent drift."""
    # frob:tests pyproject.toml kind="unit"
    pyproject = Path(__file__).parent.parent.parent / "pyproject.toml"
    data = tomllib.loads(pyproject.read_text())
    deps = data["project"]["dependencies"]
    typani_dep = next(d for d in deps if d.startswith("typani"))
    assert typani_dep == "typani>=0.2.3"


def test_typani_lint_is_clean():
    """`python -m typani.lint` must report zero findings over this
    project's generated source -- the positive control that the
    generated code follows typani's own house style."""
    # frob:tests src/{{ project.import_name }}/app/config.py kind="integration"
    src_root = Path(__file__).parent.parent.parent / "src"
    r = subprocess.run(
        [sys.executable, "-m", "typani.lint", str(src_root), "--json"],
        capture_output=True,
        text=True,
    )
    assert r.returncode == 0, r.stdout + r.stderr


def test_no_syntax_errors_in_src():
    """All source files must parse without syntax errors."""
    src_root = Path(__file__).parent.parent.parent / "src" / "{{ project.import_name }}"
    errors = []
    for py_file in src_root.rglob("*.py"):
        try:
            ast.parse(py_file.read_bytes())
        except SyntaxError as exc:
            errors.append(f"{py_file}: {exc}")

    assert not errors, "Syntax errors found:\n" + "\n".join(errors)
