"""Unit tests for the App/AppConfig wiring."""

import argparse
from pathlib import Path

from typani import Err, Ok

from {{ project.import_name }}.app import App, AppConfig
from {{ project.import_name }}.app.config import ConfigError


def test_app_config_from_external_with_no_config_file() -> None:
    # frob:tests src/{{ project.import_name }}/app/config.py::AppConfig.from_external kind="unit"
    result = AppConfig.from_external(argparse.Namespace(), config_file=None)
    assert isinstance(result, Ok)
    assert isinstance(result.danger_ok, AppConfig)


def test_app_config_from_external_with_missing_file_returns_err(tmp_path: Path) -> None:
    # frob:tests src/{{ project.import_name }}/app/config.py::AppConfig.from_external kind="unit"
    result = AppConfig.from_external(
        argparse.Namespace(), config_file=tmp_path / "missing.toml"
    )
    assert isinstance(result, Err)
    assert result.danger_err is ConfigError.NotFound


def test_app_is_callable() -> None:
    App(AppConfig())()
