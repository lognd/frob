check_base = "main"

# T-1576: brand-new scaffolded repos start on the rapid profile --
# see docs/modules/tickets.md#development-profiles-frobtoml-profile-t-1575.
# The one-way auto-ratchet upgrades this to standard automatically once
# the repo grows past frob.tickets._profile's thresholds; downgrading
# back to rapid after that is an explicit `frob profile downgrade` call.
[profile]
profile = "rapid"

# T-3931: a fresh repo has no way to know it must set this until the
# first `frob check` fires MILE003 on its own first ticket -- declare
# a sane starting point (matching the version above) day one instead.
[tickets]
default_milestone = "0.1.0"

[gates.severity]

# Thresholds sized for a fresh, minimal scaffold on day one -- raise them
# as the project's real test suite grows.
[testing]
min_unit_cases = 1
min_integration = 1
unit_branch_cov = 50
module_line_cov = 50
system_line_cov = 50

# T-4503: `frob.excludes.detect_unity_project` already auto-adds these at
# runtime for any Unity project it recognizes (T-4515) -- they are
# declared here too, explicitly, so this frob.toml is self-describing and
# portable (readable/greppable without knowing about the auto-detection
# behavior, and still correct if that heuristic is ever narrowed).
[graph]
exclude = [
{% for glob in unity.exclude_globs -%}
    "{{ glob }}",
{% endfor -%}
]

[[test.runner]]
language = "csharp"
command = ["dotnet", "test", ".", "--filter", "{filters}"]
all_command = ["dotnet", "test", "."]
cwd = "."

# T-3277: REF001/REF002 (anti-orphan gate) flags every one of these on a
# freshly scaffolded, untouched repo -- each is read by something OUTSIDE
# this project's own tracked-file graph, never referenced by name from
# source the way an import or a doc link would be.
[[refs.entrypoint]]
path = "design/*.strata"
reason = "generated by frob scaffold unity-project (T-4503) from detected .asmdef files, read by frob's strata elaborator by convention, never referenced by name from tracked source"

[[refs.entrypoint]]
path = "Assets/**/*.asmdef"
reason = "Unity's own assembly-boundary manifest, read by the Unity Editor outside this repo's own tracked-file graph, not referenced from source"

[[refs.entrypoint]]
path = "Packages/manifest.json"
reason = "Unity Package Manager's own manifest, read by the Unity Editor outside this repo's own tracked-file graph, not referenced from source"

[[refs.entrypoint]]
path = "ProjectSettings/*"
reason = "Unity Editor project settings, read by the Unity Editor outside this repo's own tracked-file graph, not referenced from source"
