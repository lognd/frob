rule WEBPERF204 "static-file-without-cache-age" {
  lang python
  severity error

  find c: call where c.text ~ /^send_file\([^)]*\)$/ and not c.text ~ /max_age/
  report c "send_file() sets no max_age, so clients cannot cache the response"

  example fire python """
    return send_file("logo.png")  #~ error
  """
  example clean python """
    return send_file("logo.png", max_age=86400)
  """
  example notapplicable markdown """
    Prose has no responses.
  """
  explain """
    Without a caching header every client refetches the file on each visit and the server pays for the bytes again (WEBPERF, server side).
    ## Remedy
    Pass `max_age=` (or set `Cache-Control` and an ETag) for files that change rarely.
  """
}
