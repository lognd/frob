rule ROUTE101 "unsafe-method-on-get-route" {
  lang python
  severity error

  find c: call where c.text ~ /add_url_rule\(.*"GET".*"(POST|PUT|DELETE)"/
  report c "one route serves GET and a state-changing method"

  example fire python """
    app.add_url_rule("/item", view_func=item, methods=["GET", "DELETE"])  #~ error
  """
  example clean python """
    app.add_url_rule("/item", view_func=item, methods=["GET"])
  """
  example notapplicable markdown """
    Prose has no routes.
  """
  explain """
    A GET handler that also changes state can be triggered by a link, a prefetch or a crawler.
    ## Remedy
    Split the route: GET reads, and POST, PUT or DELETE changes state.
  """
}
