rule PII101 "personal-data-sent-to-third-party" {
  lang python
  severity error

  find c: call where c.text ~ /\b(analytics|mixpanel|segment|sentry_sdk)\.(track|identify|capture_message|set_user)\(.*\b(ssn|email|phone|date_of_birth|credit_card)\b/
  report c "personal data is sent to a third-party service"

  example fire python """
    analytics.track("signup", {"email": user.email})  #~ error
  """
  example clean python """
    analytics.track("signup", {"user_id": user.public_id})
  """
  example notapplicable markdown """
    Prose has no calls.
  """
  explain """
    Third-party processors receive the data outside your retention and erasure controls, and each one needs a lawful basis and a data-processing agreement.
    ## Remedy
    Send a pseudonymous identifier or an aggregate count; if the value must leave, route it through a reviewed, consented processor call.
  """
}
