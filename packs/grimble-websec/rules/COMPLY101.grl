rule COMPLY101 "personal-data-in-log" {
  lang python
  severity warn

  find c: call where c.callee.name in ["info", "debug", "warning", "error"] and c.text ~ /\b(ssn|password|credit_card)\b/
  report c "a log call carries personal or secret data (PII)"

  example fire python """
    logger.info(f"login {user.email} {user.password}")  #~ warn
  """
  example clean python """
    logger.info("login user_id=%s", user.id)
  """
  example notapplicable markdown """
    Prose has no log calls.
  """
  explain """
    Logs outlive the request and are copied to many systems; personal data in them breaks
    retention and erasure promises (COMPLY, with PII).
    ## Remedy
    Log an opaque identifier, never the value; redact before the call.
  """
}
