rule LAUNCH101 "placeholder-copy" {
  lang [typescript, html]
  severity warn

  find l: literal where l.text ~ /[Ll]orem [Ii]psum/
  report l "placeholder copy left in the page: write the real text before launch"

  example fire html """
    <p>Lorem ipsum dolor sit amet</p>  <!--~ warn -->
  """
  example clean html """
    <p>Ship faster with fewer surprises.</p>
  """
  example notapplicable markdown """
    Lorem ipsum in prose is not a page.
  """
  explain """
    Placeholder text that reaches production is a launch blocker.
    ## Remedy
    Replace the placeholder with the final copy.
  """
}
