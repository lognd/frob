rule WEBPERF105 "font-preload-without-crossorigin" {
  lang [typescript, html]
  severity error

  find e: element where e.tag == "link" and e has attribute(name = "rel", value = "preload") and e has attribute(name = "as", value = "font") and not e has attribute(name = "crossorigin")
  report e "font preload has no crossorigin: the font is fetched twice"

  example fire html """
    <link rel="preload" href="inter.woff2" as="font" type="font/woff2">  <!--~ error -->
  """
  example clean html """
    <link rel="preload" href="inter.woff2" as="font" type="font/woff2" crossorigin>
  """
  example notapplicable markdown """
    A font preload is written <link rel="preload" as="font"> in prose.
  """
  explain """
    Fonts are always fetched in anonymous CORS mode, so a preload without `crossorigin` is not reused and the file downloads twice.
    ## Remedy
    Add the `crossorigin` attribute to the font preload link.
  """
}
