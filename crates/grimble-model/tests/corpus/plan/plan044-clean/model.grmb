grimble = "2";
module m;

system s {
  ambient escalate { verified_by "tests/a.py"; }
  actor u : human;
  step u.go : open { ok, bad };

  scenario t fails with { bad } {
    u.go => {
      ok => end ok;
      bad => end err(bad);
      unknown => end err(bad);
    }
  }

  impl u.go for t {
    chain {
      call c = "a.py::c" {
        PaymentDeclined => bad; _ => bad;
        verified_by "tests/a.py";
      }
    }
  }
}
