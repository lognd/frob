grimble = "2";
module m;
node a : trusted {
}
node b : trusted {
}

flow f : a -> b {
  label Public;
}
claim c1 {
  noflow a -> b;
  proof L2;
  verified_by "crates/frob/tests/wiring.rs";
}
claim c2 {
  reach a -> b;
  proof L1;
