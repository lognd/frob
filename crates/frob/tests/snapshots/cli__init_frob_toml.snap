---
source: crates/frob/tests/cli.rs
expression: toml1
---
[check]
# Lowest severity that makes `frob check` exit 1; `none` never fails.
fail_on = "error"
# Which Unresolved findings fail the gate: `required`, `never` or `all`.
fail_on_unresolved = "required"
# Ref the diff of a `--ticket` run (SCOPE001, TICK002) is taken against.
base = "main"
# Wall-clock bound in seconds of one sibling `check --json` run (sibling-contract.md section 7).
sibling_timeout_secs = 120
# When true an unusable configured sibling is a required Unresolved (`SIB001`).
require_siblings = true

[compute]
# How an unannotated public signature is treated (`warn-unresolved` or `required`).
public_signatures = "warn-unresolved"
# How an undeclared effect is treated.
effects = "warn-unresolved"
# How a dynamic call is treated.
dynamic_calls = "warn-unresolved"
# The macro and template expansion step budget.
expansion_steps = 1000
# How an unnormalizable construct is treated.
normalization = "warn-unresolved"
# How a notebook with an undeclared cell order is treated.
notebook_order = "warn-unresolved"

[directives]
# Comment namespaces the scanner reads; comments in any other are ignored.
namespaces = ["frob", "grimble", "crunk"]

[git]
# Compare-and-swap retries when moving a ledger ref.
cas_retries = 5

[tickets]
# Ref holding the ledger; the ledger merge driver and `doctor` resolve it.
ref = "refs/heads/main"
# `trunk` commits to `ref`; `branch` commits to the checked-out branch.
ref_mode = "trunk"
