          "description": "First line of `rustc --version`, when found.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "UnadaptedRow": {
      "description": "A walked file extension no adapter claims: one opaque unit per file at F0.",
      "properties": {
        "extension": {
          "description": "The extension with its dot, or `(none)`.",
          "type": "string"
        },
        "fidelity": {
          "description": "Always `F0`.",
          "type": "string"
        },
        "files": {
          "description": "Walked files with this extension.",
          "format": "uint",
          "minimum": 0,
