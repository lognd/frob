{
  "$defs": {
    "CacheInfo": {
      "description": "Cache health.",
      "properties": {
        "artifacts": {
          "description": "Rows in the artifacts table.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dir": {
          "description": "Cache directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "findings": {
          "description": "Rows in the findings table.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "repo_rule": {
          "description": "Rows in the repo-rule table.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "description": "`ok`, `null-fallback` (could not open) or `skipped: <why>`.",
          "type": "string"
        }
      },
      "required": [
        "state",
        "artifacts",
        "findings",
        "repo_rule"
      ],
      "type": "object"
    },
    "CapabilityRow": {
      "description": "One capability of an adapter with its precision label.",
      "properties": {
        "capability": {
          "description": "Capability name (`resolve_ref`, `apply_targets`, ...).",
          "type": "string"
        },
        "precision": {
          "description": "Precision label (`lexical+imports`, `none`, `not-applicable`, ...).",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "precision"
      ],
      "type": "object"
    },
    "ConfigInfo": {
      "description": "Config materialization status.",
      "properties": {
        "error": {
          "description": "Load error (unknown key, bad TOML), when any.",
          "type": [
            "string",
            "null"
          ]
        },
        "missing_knobs": {
          "description": "Materialized knobs absent from the file (each is a CFG001 finding).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "The config file.",
          "type": "string"
        },
        "present": {
          "description": "True when it exists.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "present",
        "missing_knobs"
      ],
      "type": "object"
    },
    "DriverCheck": {
      "description": "The configured ledger merge driver against the running frob.",
      "properties": {
        "command": {
          "description": "The configured driver command, when set.",
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "description": "What went wrong, when not `ok`.",
          "type": [
            "string",
            "null"
          ]
        },
        "fix": {
          "description": "The exact command that fixes it, when not `ok`.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "description": "`ok`, `mismatch` (a different frob), `unresolvable`, `unset` or `skipped`.",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "GitInfo": {
      "description": "Git discovery result.",
      "properties": {
        "branch": {
          "description": "Checked-out branch; absent when detached or not a repository.",
          "type": [
            "string",
            "null"
          ]
        },
        "discovered": {
          "description": "True when `cwd` is inside a repository.",
          "type": "boolean"
        },
        "error": {
          "description": "Why discovery or a read failed.",
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "description": "`HEAD` commit id; absent on an unborn branch.",
          "type": [
            "string",
            "null"
          ]
        },
        "linked_worktree": {
          "description": "True when this checkout is a linked worktree.",
          "type": "boolean"
        },
        "root": {
          "description": "Work tree root.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "discovered",
        "linked_worktree"
      ],
      "type": "object"
    },
    "LanguageRow": {
      "description": "One language adapter.",
      "properties": {
        "adapter": {
          "description": "Adapter name, version and grammar identity (the cache key component).",
          "type": "string"
        },
        "capabilities": {
          "description": "Capability precisions in table order.",
          "items": {
            "$ref": "#/$defs/CapabilityRow"
          },
          "type": "array"
        },
        "fidelity": {
          "description": "Fidelity level, `F0` to `F4` (universal-model.md 3.3).",
          "type": "string"
        },
        "files": {
          "description": "Walked files this adapter claims.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "language": {
          "description": "Language tag (`rust`, `markdown`).",
          "type": "string"
        }
      },
      "required": [
        "language",
        "fidelity",
        "adapter",
        "files",
        "capabilities"
      ],
      "type": "object"
    },
    "LanguagesReport": {
      "description": "`doctor --languages`: adapters and the extensions that have none.",
      "properties": {
        "adapters": {
          "description": "Every adapter, then the F0 adapter.",
          "items": {
            "$ref": "#/$defs/LanguageRow"
          },
          "type": "array"
        },
        "unadapted": {
          "description": "Extensions with no adapter, sorted.",
          "items": {
            "$ref": "#/$defs/UnadaptedRow"
          },
          "type": "array"
        }
      },
      "required": [
        "adapters",
        "unadapted"
      ],
      "type": "object"
    },
    "LedgerInfo": {
      "description": "Ledger ref reachability.",
      "properties": {
        "error": {
          "description": "Why it does not resolve.",
          "type": [
            "string",
            "null"
          ]
        },
        "oid": {
          "description": "What it resolves to.",
          "type": [
            "string",
            "null"
          ]
        },
        "reachable": {
          "description": "True when the ref resolves to an object.",
          "type": "boolean"
        },
        "ref": {
          "description": "The configured `[tickets] ref`.",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "reachable"
      ],
      "type": "object"
    },
    "OtherCopy": {
      "description": "A second copy of a sibling in the other location (D87).",
      "properties": {
        "differs": {
          "description": "True when its version differs from the copy in use.",
          "type": "boolean"
        },
        "path": {
          "description": "Where it is: `path` (the copy beside frob is the one in use).",
          "type": "string"
        },
        "version": {
          "description": "First line of its `--version`, when it ran.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "differs"
      ],
      "type": "object"
    },
    "SiblingRow": {
      "description": "One sibling product as frob discovers it: beside the running executable first, then on `PATH`.",
      "properties": {
        "location": {
          "description": "`beside-frob`, `path` or `absent`.",
