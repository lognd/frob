          "description": "The executable in use, when found.",
          "type": [
            "string",
            "null"
          ]
        },
        "product": {
          "description": "Product (`grimble`, `crunk`).",
          "type": "string"
        },
        "version": {
          "description": "First line of its `--version`, when it ran.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "product",
        "location"
      ],
      "type": "object"
    },
    "Toolchain": {
      "description": "Versions of the tools frob shells out to.",
      "properties": {
        "cargo": {
          "description": "First line of `cargo --version`, when found.",
          "type": [
            "string",
            "null"
          ]
        },
