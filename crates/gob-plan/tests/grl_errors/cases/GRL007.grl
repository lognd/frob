rule UNIV002 "unsafe-anywhere" {
  lang *

  find u: rust`unsafe { $$$BODY }` as roles
  report u "unsafe code needs a review"

  example fire """
    fn f(x: u32) -> u32 { dbg!(x) }        //~ warn
  """
  example clean """
    fn f(x: u32) -> u32 { x }
  """

  explain """
    `dbg!` prints to stderr and is meant for local debugging only.

    ## Remedy
    Delete the call, or log through `tracing` if the value matters.
  """
}
